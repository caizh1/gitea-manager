new file mode 100644
index 0000000..f32082a
--- /dev/null
+++ b/services/migrationreceiver/issue_fields_test.go
@@ -0,0 +1,45 @@
+// Copyright 2026 Gitea.
+// SPDX-License-Identifier: MIT
+
+package migrationreceiver
+
+import (
+	"strings"
+	"testing"
+
+	"gitea.dev/models/db"
+	issues "gitea.dev/models/issues"
+	repos "gitea.dev/models/repo"
+	"gitea.dev/models/unittest"
+	users "gitea.dev/models/user"
+	"github.com/stretchr/testify/require"
+)
+
+func TestIssueDeadlineIsStoredAndIndependentlyVerified(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	ctx := t.Context()
+	actor, err := users.GetUserByID(ctx, 1)
+	require.NoError(t, err)
+	key := strings.Repeat("d", 32)
+	repo := &repos.Repository{OwnerID: actor.ID, Name: "gm-migrate-" + key, LowerName: "gm-migrate-" + key, IsPrivate: true}
+	require.NoError(t, db.Insert(ctx, repo))
+	_, err = Start(ctx, actor, StartOptions{Key: key, RepoID: repo.ID, SourceDigest: strings.Repeat("e", 64)})
+	require.NoError(t, err)
+	receipts, err := Apply(ctx, actor, key, []Object{{Kind: "issue", SourceID: "deadline-issue", Number: 1,
+		Title: "保留截止日期和锁定状态", State: "open", Author: "来源作者", Created: 1600000000, Updated: 1600000010,
+		Deadline: 1794285296, Locked: true}})
+	require.NoError(t, err)
+	issue, err := issues.GetIssueByID(ctx, receipts[0].TargetID)
+	require.NoError(t, err)
+	require.EqualValues(t, 1794285296, issue.DeadlineUnix)
+	require.True(t, issue.IsLocked)
+	page, err := Read(ctx, actor, key, 0)
+	require.NoError(t, err)
+	require.True(t, page.Objects[0].Matches)
+	_, err = db.GetEngine(ctx).ID(issue.ID).Cols("deadline_unix").Update(&issues.Issue{})
+	require.NoError(t, err)
+	page, err = Read(ctx, actor, key, 0)
+	require.NoError(t, err)
+	require.False(t, page.Objects[0].Matches)
+	require.ErrorIs(t, Seal(ctx, actor, key, 1, 0), ErrConflict)
+}
