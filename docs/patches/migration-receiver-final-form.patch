diff --git a/services/migrationreceiver/batch.go b/services/migrationreceiver/batch.go
new file mode 100644
index 0000000..b53e6b1
--- /dev/null
+++ b/services/migrationreceiver/batch.go
@@ -0,0 +1,244 @@
+// Copyright 2026 Gitea.
+// SPDX-License-Identifier: MIT
+
+package migrationreceiver
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"gitea.dev/models/db"
+	governance "gitea.dev/models/governance"
+	issues "gitea.dev/models/issues"
+	repos "gitea.dev/models/repo"
+	users "gitea.dev/models/user"
+	"gitea.dev/modules/git/gitcmd"
+	"gitea.dev/modules/gitrepo"
+	"xorm.io/builder"
+)
+
+type BatchRepo struct {
+	GroupRevision int64  `json:"group_revision"`
+	Key           string `json:"key"`
+	RepoID        int64  `json:"repo_id"`
+	Archived      bool   `json:"archived"`
+}
+
+func lockBatch(ctx context.Context, actorID int64, key string) error {
+	n, e := db.GetEngine(ctx).Table(new(governance.MigrationBatch)).Where("key = ? AND actor_id = ?", key, actorID).Incr("revision").Update(&governance.MigrationBatch{})
+	if e != nil {
+		return e
+	}
+	if n != 1 {
+		return ErrConflict
+	}
+	return nil
+}
+
+func finalFingerprint(ctx context.Context, s *governance.MigrationSession) (string, error) {
+	r, e := repos.GetRepositoryByID(ctx, s.RepoID)
+	if e != nil {
+		return "", e
+	}
+	if r.OwnerID != s.TargetOwnerID || r.Name != s.TargetName || !r.IsPrivate || !r.IsArchived {
+		return "", ErrConflict
+	}
+	var receipts []*governance.MigrationReceipt
+	if err := db.GetEngine(ctx).Where("session_id = ?", s.ID).Find(&receipts); err != nil {
+		return "", err
+	}
+	for _, receipt := range receipts {
+		ok, err := verify(ctx, s, receipt)
+		if err != nil {
+			return "", err
+		}
+		if !ok {
+			return "", ErrConflict
+		}
+	}
+	bad, err := db.GetEngine(ctx).SQL("SELECT COUNT(*) AS n FROM governance_migration_asset a LEFT JOIN package_file f ON f.id=a.package_file_id LEFT JOIN package_blob b ON b.id=f.blob_id WHERE a.session_id=? AND a.parent_kind='package' AND (f.id IS NULL OR b.hash_sha256<>a.sh_a256 OR b.size<>a.size)", s.ID).Query()
+	if err != nil {
+		return "", err
+	}
+	if len(bad) != 1 || string(bad[0]["n"]) != "0" {
+		return "", ErrConflict
+	}
+	values := map[string]any{"owner": r.OwnerID, "name": r.Name, "description": r.Description, "private": r.IsPrivate, "archived": r.IsArchived, "default_branch": r.DefaultBranch}
+	for name, repository := range map[string]gitrepo.Repository{"git_refs": r, "wiki_refs": r.WikiStorageRepo()} {
+		if name == "wiki_refs" {
+			exists, err := gitrepo.IsRepositoryExist(ctx, repository)
+			if err != nil {
+				return "", err
+			}
+			if !exists {
+				values[name] = ""
+				continue
+			}
+		}
+		refs, _, err := gitrepo.RunCmdString(ctx, repository, gitcmd.NewCommand("for-each-ref").AddArguments("--format=%(refname) %(objectname)"))
+		if err != nil {
+			return "", err
+		}
+		values[name] = refs
+	}
+	for _, t := range []string{"protected_branch", "protected_tag", "repo_unit"} {
+		rows, e := db.GetEngine(ctx).SQL("SELECT * FROM "+t+" WHERE repo_id = ? ORDER BY id", r.ID).Query()
+		if e != nil {
+			return "", e
+		}
+		values[t] = rows
+	}
+	// 所属群组链的修订变化会使发布凭证失效。
+	chain, e := governance.Ancestors(ctx, r.OwnerID)
+	if e != nil {
+		return "", e
+	}
+	values["groups"] = chain
+	raw, e := json.Marshal(values)
+	if e != nil {
+		return "", e
+	}
+	sum := sha256.Sum256(raw)
+	return hex.EncodeToString(sum[:]), nil
+}
+
+// PrepareBatch 保存最终规则与归属指纹，任何仓库未完成时都不能开放。
+func PrepareBatch(ctx context.Context, actor *users.User, key string, items []BatchRepo) error {
+	if actor == nil || !actor.IsAdmin || !keyPattern.MatchString(key) {
+		return ErrInvalid
+	}
+	return db.WithTx(ctx, func(ctx context.Context) error {
+		if e := lockBatch(ctx, actor.ID, key); e != nil {
+			return e
+		}
+		b := &governance.MigrationBatch{}
+		ok, e := db.GetEngine(ctx).Where("key = ? AND actor_id = ?", key, actor.ID).Get(b)
+		if e != nil {
+			return e
+		}
+		if !ok || b.State == "published" || len(items) != b.Expected {
+			return ErrConflict
+		}
+		var sessions []*governance.MigrationSession
+		if e = db.GetEngine(ctx).Where("batch_key = ? AND publish_barrier = ?", key, true).Find(&sessions); e != nil {
+			return e
+		}
+		if len(sessions) != b.Expected {
+			return ErrConflict
+		}
+		seen := map[string]bool{}
+		for _, item := range items {
+			if seen[item.Key] {
+				return ErrInvalid
+			}
+			seen[item.Key] = true
+			var s *governance.MigrationSession
+			for _, v := range sessions {
+				if v.Key == item.Key && v.RepoID == item.RepoID {
+					s = v
+					break
+				}
+			}
+			if s == nil || s.ActorID != actor.ID || s.State != "handed_off" {
+				return ErrConflict
+			}
+			namespace, e := governance.GetNamespace(ctx, s.TargetOwnerID)
+			if e != nil {
+				return e
+			}
+			if item.GroupRevision <= 0 || namespace.Revision != item.GroupRevision {
+				return ErrConflict
+			}
+			digest, e := finalFingerprint(ctx, s)
+			if e != nil {
+				return e
+			}
+			if b.State == "prepared" && (s.VerifiedDigest != digest || s.DesiredArchived != item.Archived) {
+				return ErrConflict
+			}
+			if _, e = db.GetEngine(ctx).ID(s.ID).Cols("verified_digest", "desired_archived").Update(&governance.MigrationSession{VerifiedDigest: digest, DesiredArchived: item.Archived}); e != nil {
+				return e
+			}
+		}
+		_, e = db.GetEngine(ctx).Where("key = ?", key).Cols("state").Update(&governance.MigrationBatch{State: "prepared"})
+		return e
+	})
+}
+
+// PublishBatch 的事务只修改可见性和最终归档状态，不再搬运文件或首次安装规则。
+func PublishBatch(ctx context.Context, actor *users.User, key string) error {
+	if actor == nil || !actor.IsAdmin || !keyPattern.MatchString(key) {
+		return ErrInvalid
+	}
+	return db.WithTx(ctx, func(ctx context.Context) error {
+		if e := lockBatch(ctx, actor.ID, key); e != nil {
+			return e
+		}
+		b := &governance.MigrationBatch{}
+		ok, e := db.GetEngine(ctx).Where("key = ? AND actor_id = ?", key, actor.ID).Get(b)
+		if e != nil {
+			return e
+		}
+		if !ok {
+			return ErrConflict
+		}
+		if b.State == "published" {
+			return activatePublishedPulls(ctx, key)
+		}
+		if b.State != "prepared" {
+			return ErrConflict
+		}
+		var sessions []*governance.MigrationSession
+		if e = db.GetEngine(ctx).Where("batch_key = ? AND publish_barrier = ?", key, true).Find(&sessions); e != nil {
+			return e
+		}
+		if len(sessions) != b.Expected {
+			return ErrConflict
+		}
+		for _, s := range sessions {
+			if s.State != "handed_off" || s.VerifiedDigest == "" {
+				return ErrConflict
+			}
+			v, e := finalFingerprint(ctx, s)
+			if e != nil {
+				return e
+			}
+			if v != s.VerifiedDigest {
+				return ErrConflict
+			}
+		}
+		for _, s := range sessions {
+			if _, e = db.GetEngine(ctx).ID(s.RepoID).Cols("is_archived").Update(&repos.Repository{IsArchived: s.DesiredArchived}); e != nil {
+				return e
+			}
+		}
+		_, e = db.GetEngine(ctx).Where("key = ? AND state = ?", key, "prepared").Cols("state").Update(&governance.MigrationBatch{State: "published"})
+		if e != nil {
+			return e
+		}
+		return activatePublishedPulls(ctx, key)
+	})
+}
+
+// 开放后进入原生按需检查，保留已关闭或已合并请求的历史；重试不覆盖有效检查结果。
+func activatePublishedPulls(ctx context.Context, key string) error {
+	repositories := builder.Select("repo_id").From("governance_migration_session").Where(builder.Eq{"batch_key": key, "publish_barrier": true})
+	openIssues := builder.Select("id").From("issue").Where(builder.Eq{"is_closed": false})
+	_, err := db.GetEngine(ctx).In("base_repo_id", repositories).Where("has_merged = ? AND status = ?", false, issues.PullRequestStatusError).And(builder.In("issue_id", openIssues)).Cols("status").Update(&issues.PullRequest{Status: issues.PullRequestStatusChecking})
+	return err
+}
+func BatchStatus(ctx context.Context, actor *users.User, key string) (*governance.MigrationBatch, error) {
+	if actor == nil || !actor.IsAdmin {
+		return nil, ErrInvalid
+	}
+	b := &governance.MigrationBatch{}
+	ok, e := db.GetEngine(ctx).Where("key = ? AND actor_id = ?", key, actor.ID).Get(b)
+	if e != nil {
+		return nil, e
+	}
+	if !ok {
+		return nil, ErrConflict
+	}
+	return b, nil
+}
