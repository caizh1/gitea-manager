diff --git a/models/governance/migration_batch.go b/models/governance/migration_batch.go
new file mode 100644
index 0000000..b5827e7
--- /dev/null
+++ b/models/governance/migration_batch.go
@@ -0,0 +1,47 @@
+// Copyright 2026 Gitea.
+// SPDX-License-Identifier: MIT
+
+package governance
+
+import (
+	"context"
+	"gitea.dev/models/db"
+	"xorm.io/builder"
+)
+
+// MigrationBatch 用同一数据库提交控制整批可见性，失败时保持隔离。
+type MigrationBatch struct {
+	Key      string `xorm:"pk VARCHAR(64)" json:"key"`
+	ActorID  int64  `json:"actor_id"`
+	Revision int64  `json:"revision"`
+	Expected int    `json:"expected"`
+	State    string `xorm:"VARCHAR(32)" json:"state"`
+}
+
+func (*MigrationBatch) TableName() string { return "governance_migration_batch" }
+func init()                               { db.RegisterModel(new(MigrationBatch)) }
+
+func QuarantinedMigrationIDs() *builder.Builder {
+	return builder.Select("s.repo_id").From("governance_migration_session s").
+		Join("INNER", "governance_migration_batch b", "s.batch_key=b.key").
+		Where(builder.And(builder.Eq{"s.publish_barrier": true}, builder.Neq{"b.state": "published"}))
+}
+func MigrationQuarantined(ctx context.Context, repoID int64) (bool, error) {
+	return db.GetEngine(ctx).Where(builder.In("repo_id", QuarantinedMigrationIDs())).And("repo_id = ?", repoID).Exist(new(MigrationSession))
+}
+
+type MigrationPackageReaderKey struct{}
+
+func MigrationPackageCondition(ctx context.Context) builder.Cond {
+	if allowed, _ := ctx.Value(MigrationPackageReaderKey{}).(bool); allowed {
+		return builder.NewCond()
+	}
+	return builder.NotIn("package.repo_id", QuarantinedMigrationIDs())
+}
+
+type MigrationEvaluationKey struct{}
+
+func MigrationEvaluation(ctx context.Context, repoID int64) bool {
+	id, _ := ctx.Value(MigrationEvaluationKey{}).(int64)
+	return id == repoID
+}
