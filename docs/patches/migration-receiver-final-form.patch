+// Copyright 2026 Gitea.
+// SPDX-License-Identifier: MIT
+package migrationreceiver
+
+import (
+	"gitea.dev/models/db"
+	governance "gitea.dev/models/governance"
+	issues "gitea.dev/models/issues"
+	"gitea.dev/models/unittest"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestPublishedPullActivationPreservesHistory(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	ctx := t.Context()
+	require.NoError(t, db.Insert(ctx, &governance.MigrationSession{Key: "activation", BatchKey: "batch", RepoID: 1, PublishBarrier: true}))
+	for index, closed := range []bool{false, true} {
+		issue := &issues.Issue{RepoID: 1, Index: int64(900 + index), IsPull: true, IsClosed: closed, Title: "迁入请求"}
+		require.NoError(t, db.Insert(ctx, issue))
+		pr := &issues.PullRequest{IssueID: issue.ID, Index: issue.Index, BaseRepoID: 1, HeadRepoID: 1, Status: issues.PullRequestStatusError, MergeBase: "保留原始提交"}
+		require.NoError(t, db.Insert(ctx, pr))
+		require.NoError(t, activatePublishedPulls(ctx, "batch"))
+		actual, err := issues.GetPullRequestByID(ctx, pr.ID)
+		require.NoError(t, err)
+		if closed {
+			require.Equal(t, issues.PullRequestStatusError, actual.Status)
+		} else {
+			require.Equal(t, issues.PullRequestStatusChecking, actual.Status)
+		}
+		require.Equal(t, "保留原始提交", actual.MergeBase)
+	}
+}
