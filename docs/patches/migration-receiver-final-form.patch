+package migrationreceiver
+
+import (
+	"gitea.dev/models/db"
+	governance "gitea.dev/models/governance"
+	repos "gitea.dev/models/repo"
+	"gitea.dev/models/unittest"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestRecallClearsOnlyOwnAliasesAndRedirects(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	ctx := t.Context()
+	for _, row := range []*governance.ResourcePath{
+		{Path: "cancelled/repo", Kind: "repository", ResourceID: 1234, Alias: true},
+		{Path: "archive/repo", Kind: "repository", ResourceID: 1234, Alias: false},
+		{Path: "other/repo", Kind: "repository", ResourceID: 5678, Alias: true},
+	} {
+		require.NoError(t, db.Insert(ctx, row))
+	}
+	require.NoError(t, db.Insert(ctx, &repos.Redirect{OwnerID: 3, LowerName: "cancelled", RedirectRepoID: 1234}, &repos.Redirect{OwnerID: 3, LowerName: "other", RedirectRepoID: 5678}))
+	require.NoError(t, clearMigrationAliases(ctx, 1234))
+	require.NoError(t, clearMigrationAliases(ctx, 1234))
+	n, err := db.GetEngine(ctx).Where("redirect_repo_id = ?", 1234).Count(new(repos.Redirect))
+	require.NoError(t, err)
+	require.Zero(t, n)
+	n, err = db.GetEngine(ctx).Where("redirect_repo_id = ?", 5678).Count(new(repos.Redirect))
+	require.NoError(t, err)
+	require.EqualValues(t, 1, n)
+	n, err = db.GetEngine(ctx).Where("path = ?", "archive/repo").Count(new(governance.ResourcePath))
+	require.NoError(t, err)
+	require.EqualValues(t, 1, n)
+	n, err = db.GetEngine(ctx).Where("path = ?", "other/repo").Count(new(governance.ResourcePath))
+	require.NoError(t, err)
+	require.EqualValues(t, 1, n)
+}
