+	for i, name := range []string{"batch-one", "batch-two"} {
+		r := &repos.Repository{OwnerID: 3, Name: name, LowerName: name, IsPrivate: true, IsArchived: true}
+		require.NoError(t, db.Insert(ctx, r))
+		ids = append(ids, r.ID)
+		require.NoError(t, git.InitRepository(ctx, r.RepoPath(), true, "sha1"))
+		require.NoError(t, db.Insert(ctx, &repos.RepoUnit{RepoID: r.ID, Type: unit.TypeCode}))
+		s := &governance.MigrationSession{Key: strings.Repeat(string(rune('a'+i)), 32), BatchKey: key, ActorID: actor.ID, RepoID: r.ID, State: "handed_off", PublishBarrier: true, TargetOwnerID: 3, TargetName: name}
+		require.NoError(t, db.Insert(ctx, s))
+		namespace, e := governance.GetNamespace(ctx, 3)
+		require.NoError(t, e)
+		items = append(items, BatchRepo{Key: s.Key, RepoID: r.ID, GroupRevision: namespace.Revision, Archived: i == 1})
+		p, e := access.GetIndividualUserRepoPermission(ctx, r, reader)
+		require.NoError(t, e)
+		require.False(t, p.CanRead(unit.TypeCode))
+	}
+	require.ErrorIs(t, PrepareBatch(ctx, actor, key, items[:1]), ErrConflict)
+	require.NoError(t, PrepareBatch(ctx, actor, key, items))
+	repo, e := repos.GetRepositoryByID(ctx, ids[0])
+	require.NoError(t, e)
+	blob, _, e := gitcmd.NewCommand("hash-object", "-w", "--stdin").WithDir(repo.RepoPath()).WithStdinBytes([]byte("预演后新增内容")).RunStdString(ctx)
+	require.NoError(t, e)
+	require.NoError(t, gitcmd.NewCommand("update-ref").AddDynamicArguments("refs/tags/changed-after-rehearsal", strings.TrimSpace(blob)).WithDir(repo.RepoPath()).Run(ctx))
+	require.ErrorIs(t, PrepareBatch(ctx, actor, key, items), ErrConflict)
+	require.ErrorIs(t, PublishBatch(ctx, actor, key), ErrConflict)
+	require.NoError(t, gitcmd.NewCommand("update-ref", "-d", "refs/tags/changed-after-rehearsal").WithDir(repo.RepoPath()).Run(ctx))
+	changed := &repos.RepoUnit{RepoID: ids[1], Type: unit.TypeActions}
+	require.NoError(t, db.Insert(ctx, changed))
+	require.ErrorIs(t, PrepareBatch(ctx, actor, key, items), ErrConflict)
+	require.ErrorIs(t, PublishBatch(ctx, actor, key), ErrConflict)
+	for _, id := range ids {
+		r, e := repos.GetRepositoryByID(ctx, id)
+		require.NoError(t, e)
+		require.True(t, r.IsArchived)
+		blocked, e := governance.MigrationQuarantined(ctx, id)
+		require.NoError(t, e)
+		require.True(t, blocked)
+	}
+	_, e = db.GetEngine(ctx).ID(changed.ID).Delete(new(repos.RepoUnit))
+	require.NoError(t, e)
+	require.NoError(t, PrepareBatch(ctx, actor, key, items))
+	require.NoError(t, PublishBatch(ctx, actor, key))
+	require.NoError(t, PublishBatch(ctx, actor, key))
+	for i, id := range ids {
+		r, e := repos.GetRepositoryByID(ctx, id)
