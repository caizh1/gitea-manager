@@ -0,0 +1,14 @@
+//go:build unix
+
+// Copyright 2026 Gitea.
+// SPDX-License-Identifier: MIT
+
+package governance
+
+import "golang.org/x/sys/unix"
+
+func migrationDisk(path string) (uint64, uint64, error) {
+	var s unix.Statfs_t
+	e := unix.Statfs(path, &s)
+	return uint64(s.Bavail) * uint64(s.Bsize), uint64(s.Ffree), e
+}
