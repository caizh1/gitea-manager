diff --git a/routers/api/v1/governance/migration_capacity.go b/routers/api/v1/governance/migration_capacity.go
new file mode 100644
index 0000000..e089562
--- /dev/null
+++ b/routers/api/v1/governance/migration_capacity.go
@@ -0,0 +1,84 @@
+// Copyright 2026 Gitea.
+// SPDX-License-Identifier: MIT
+
+package governance
+
+import (
+	stdctx "context"
+	"crypto/rand"
+	"encoding/hex"
+	"errors"
+	"gitea.dev/models/db"
+	governance_model "gitea.dev/models/governance"
+	"gitea.dev/modules/setting"
+	"gitea.dev/services/context"
+	"net/http"
+	"os"
+	"path/filepath"
+)
+
+func MigrationCapacity(ctx *context.APIContext) {
+	paths := map[string]string{"repositories": setting.RepoRootPath, "data": setting.AppDataPath}
+	unsupported := []string{}
+	for name, cfg := range map[string]*setting.Storage{"attachments": setting.Attachment.Storage, "packages": setting.Packages.Storage} {
+		if cfg == nil || cfg.Type != setting.LocalStorageType {
+			unsupported = append(unsupported, name)
+			continue
+		}
+		paths[name] = cfg.Path
+	}
+	values := map[string]any{}
+	for name, path := range paths {
+		if err := os.MkdirAll(path, 0o700); err != nil {
+			ctx.APIError(http.StatusServiceUnavailable, "目标存储目录不可写")
+			return
+		}
+		free, files, err := migrationDisk(path)
+		if err != nil {
+			ctx.APIError(http.StatusServiceUnavailable, "目标容量无法核实")
+			return
+		}
+		f, err := os.CreateTemp(path, ".migration-probe-")
+		if err != nil {
+			ctx.APIError(http.StatusServiceUnavailable, "目标存储写入探测失败")
+			return
+		}
+		_, err = f.Write([]byte("迁移存储写入探测"))
+		if err == nil {
+			err = f.Sync()
+		}
+		f.Close()
+		os.Remove(f.Name())
+		if err != nil {
+			ctx.APIError(http.StatusServiceUnavailable, "目标存储落盘探测失败")
+			return
+		}
+		values[name] = map[string]any{"free_bytes": free, "free_inodes": files, "filesystem": filepath.Clean(path)}
+	}
+	if _, err := db.GetEngine(ctx).SQL("SELECT 1").Query(); err != nil {
+		ctx.APIError(http.StatusServiceUnavailable, "目标数据库不可读")
+		return
+	}
+	if ctx.Req.URL.Query().Get("live") == "true" {
+		// 上传可能持有 SQLite 写锁；持续监测不得争抢它。
+		ctx.JSON(http.StatusOK, map[string]any{"storage": values, "unsupported": unsupported, "database": "readable"})
+		return
+	}
+	rollback := errors.New("容量探测回滚")
+	random := make([]byte, 16)
+	if _, err := rand.Read(random); err != nil {
+		ctx.APIError(http.StatusServiceUnavailable, "目标写入探测无法生成标识")
+		return
+	}
+	err := db.WithTx(ctx, func(tx stdctx.Context) error {
+		if _, err := db.GetEngine(tx).Insert(&governance_model.MigrationBatch{Key: "probe-" + hex.EncodeToString(random), ActorID: ctx.Doer.ID, State: "probe"}); err != nil {
+			return err
+		}
+		return rollback
+	})
+	if !errors.Is(err, rollback) {
+		ctx.APIError(http.StatusServiceUnavailable, "目标数据库写入探测失败")
+		return
+	}
+	ctx.JSON(http.StatusOK, map[string]any{"storage": values, "unsupported": unsupported, "database": "writable"})
+}
