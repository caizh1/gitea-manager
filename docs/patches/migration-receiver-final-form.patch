+++ b/services/migrationreceiver/recall.go
@@ -0,0 +1,80 @@
+// Copyright 2026 Gitea.
+// SPDX-License-Identifier: MIT
+
+package migrationreceiver
+
+import (
+	"context"
+	"errors"
+	"gitea.dev/models/db"
+	governance "gitea.dev/models/governance"
+	packages "gitea.dev/models/packages"
+	repos "gitea.dev/models/repo"
+	users "gitea.dev/models/user"
+	package_service "gitea.dev/services/packages"
+	repository "gitea.dev/services/repository"
+)
+
+// recallPrepared 只回收尚未开放的本批次内容，原文件仍保存在隔离仓库和附件回执中。
+func recallPrepared(ctx context.Context, actor *users.User, s *governance.MigrationSession, repo *repos.Repository) error {
+	var assets []*governance.MigrationAsset
+	if err := db.GetEngine(ctx).Where("session_id = ? AND package_id > 0", s.ID).Find(&assets); err != nil {
+		return err
+	}
+	ids := map[int64]bool{}
+	files := map[int64]bool{}
+	for _, a := range assets {
+		ids[a.PackageID] = true
+		files[a.PackageFileID] = true
+	}
+	ctx = context.WithValue(ctx, governance.MigrationPackageReaderKey{}, true)
+	for id := range ids {
+		pkg, err := packages.GetPackageByID(ctx, id)
+		if errors.Is(err, packages.ErrPackageNotExist) {
+			continue
+		}
+		if err != nil {
+			return err
+		}
+		if pkg.RepoID != repo.ID {
+			return ErrConflict
+		}
+		var actual []*packages.PackageFile
+		if err = db.GetEngine(ctx).Table("package_file").Join("INNER", "package_version", "package_file.version_id=package_version.id").Where("package_version.package_id = ?", id).Find(&actual); err != nil {
+			return err
+		}
+		for _, f := range actual {
+			if !files[f.ID] {
+				return ErrConflict
+			}
+		}
+		if err = package_service.RemovePackage(ctx, actor, pkg); err != nil {
+			return err
+		}
+	}
+	if repo.OwnerID != actor.ID || repo.Name != "gm-migrate-"+s.Key {
+		scoped, err := governance.SealedMigrationPathContext(ctx, s.Key, actor.ID)
+		if err != nil {
+			return err
+		}
+		if repo.Name != "gm-migrate-"+s.Key {
+			if err = repository.ChangeRepositoryName(scoped, actor, repo, "gm-migrate-"+s.Key); err != nil {
+				return err
+			}
+		}
+		if repo.OwnerID != actor.ID {
+			if err = repository.StartRepositoryTransfer(scoped, actor, actor, repo, nil); err != nil {
+				return err
+			}
+		}
+	}
+	return clearMigrationAliases(ctx, repo.ID)
+}
+
+func clearMigrationAliases(ctx context.Context, repoID int64) error {
+	if _, err := db.GetEngine(ctx).Where("kind = ? AND resource_id = ? AND alias = ?", "repository", repoID, true).Delete(new(governance.ResourcePath)); err != nil {
+		return err
+	}
+	_, err := db.GetEngine(ctx).Where("redirect_repo_id = ?", repoID).Delete(new(repos.Redirect))
+	return err
+}
