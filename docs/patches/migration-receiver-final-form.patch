+// readableSession 保留最终形态隔离后的原管理员回读能力，不重新开放写入。
+func readableSession(ctx context.Context, actor *users.User, s *governance.MigrationSession) error {
+	if s.PublishBarrier && s.State == "handed_off" {
+		r, err := repos.GetRepositoryByID(ctx, s.RepoID)
+		if err != nil {
+			return err
+		}
+		if actor == nil || !actor.IsAdmin || actor.ID != s.ActorID || !r.IsPrivate || !r.IsArchived || r.OwnerID != s.TargetOwnerID || r.Name != s.TargetName {
+			return ErrConflict
+		}
+		return nil
+	}
+	_, err := isolation(ctx, actor, s.RepoID, s.Key)
+	return err
+}
