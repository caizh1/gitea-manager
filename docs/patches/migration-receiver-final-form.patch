+// Copyright 2026 Gitea.
+// SPDX-License-Identifier: MIT
+package pull
+
+import (
+	"gitea.dev/models/db"
+	governance "gitea.dev/models/governance"
+	issues "gitea.dev/models/issues"
+	"gitea.dev/models/unittest"
+	"github.com/stretchr/testify/require"
+	"strings"
+	"testing"
+)
+
+func TestQuarantinedMigrationDoesNotRewritePullState(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	ctx := t.Context()
+	pr := unittest.AssertExistsAndLoadBean(t, &issues.PullRequest{ID: 2})
+	key := strings.Repeat("a", 32)
+	require.NoError(t, db.Insert(ctx, &governance.MigrationBatch{Key: key, ActorID: 1, State: "preparing", Expected: 1}, &governance.MigrationSession{Key: key, BatchKey: key, ActorID: 1, RepoID: pr.BaseRepoID, State: "sealed", PublishBarrier: true}))
+	before := pr.Status
+	require.False(t, markPullRequestStatusAsChecking(ctx, pr))
+	require.Equal(t, before, pr.Status)
+}
