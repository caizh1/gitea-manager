+func TestMigrationPackageAuditDoesNotExposeGroupMetadata(t *testing.T) {
+	ctx, _, owner, _, _, _ := reviewPackage(t, "generic")
+	filter := governance.AuditFilter{ScopeType: "group", ScopeID: owner.ID, From: time.Now().UTC().Add(-time.Hour), To: time.Now().UTC().Add(time.Second), EventType: "package.version_published"}
+	page, err := governance.QueryAudit(ctx, filter, 0, 100)
