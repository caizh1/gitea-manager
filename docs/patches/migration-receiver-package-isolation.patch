+func TestNugetMultipleVersionProvenance(t *testing.T) {
+	ctx, actor, _, repo, s, _ := reviewPackage(t, "nuget", 2)
+	rows, err := nativeReceipts(ctx, s)
+	require.NoError(t, err)
+	require.Len(t, rows, 1)
+	var snapshot nativeSnapshot
+	require.NoError(t, json.Unmarshal([]byte(rows[0].Data), &snapshot))
+	require.Len(t, snapshot.Derived, 2)
+	values := map[string]bool{}
+	for _, value := range snapshot.Derived {
+		values[value] = true
+	}
+	require.True(t, values["package:nuget-nuspec-v1"])
+	require.True(t, values["package2:nuget-nuspec-v1"])
+	require.NoError(t, Abort(ctx, actor, s.Key, repo.ID, ""))
+}
