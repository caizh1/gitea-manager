@@ -0,0 +1,85 @@
+// Copyright 2026 Gitea.
+// SPDX-License-Identifier: MIT
+
+package governance
+
+import (
+	"context"
+	"gitea.dev/models/db"
+)
+
+// MigrationPackageReceipt 先占用逻辑身份，再原子登记原生内容；回收记录始终保留。
+type MigrationPackageReceipt struct {
+	ID        int64  `xorm:"pk autoincr"`
+	SessionID int64  `xorm:"UNIQUE(migration_package) NOT NULL"`
+	OwnerID   int64  `xorm:"INDEX"`
+	Type      string `xorm:"VARCHAR(32) UNIQUE(migration_package)"`
+	Name      string `xorm:"VARCHAR(255) UNIQUE(migration_package)"`
+	PackageID int64  `xorm:"INDEX"`
+	Data      string `xorm:"LONGTEXT"`
+	Recalled  bool
+}
+
+func (*MigrationPackageReceipt) TableName() string { return "governance_migration_package_receipt" }
+
+type migrationPackageScopeKey struct{}
+type migrationPackageScope struct {
+	SessionID, ActorID int64
+	Operation          string
+}
+
+// MigrationPackageContext 仅服务端可创建，并在每次底层写入重新核对持久状态。
+func MigrationPackageContext(ctx context.Context, sessionID, actorID int64, operation string) context.Context {
+	return context.WithValue(ctx, migrationPackageScopeKey{}, migrationPackageScope{sessionID, actorID, operation})
+}
+func CheckMigrationPackageWrite(ctx context.Context, ownerID int64, kind, name string, packageID, repoID int64) error {
+	var records []*MigrationPackageReceipt
+	if err := db.GetEngine(ctx).Where("(owner_id = ? AND type = ? AND name = ?) OR (package_id > 0 AND package_id = ?)", ownerID, kind, name, packageID).Find(&records); err != nil {
+		return err
+	}
+	for _, r := range records {
+		s := &MigrationSession{}
+		ok, err := db.GetEngine(ctx).ID(r.SessionID).Get(s)
+		if err != nil {
+			return err
+		}
+		if !ok {
+			return ErrConflict
+		}
+		b := &MigrationBatch{}
+		ok, err = db.GetEngine(ctx).Where("key = ?", s.BatchKey).Get(b)
+		if err != nil {
+			return err
+		}
+		if (r.Recalled && s.State == "abandoned") || (ok && b.State == "published") {
+			continue
+		}
+		scope, scoped := ctx.Value(migrationPackageScopeKey{}).(migrationPackageScope)
+		if !scoped || scope.SessionID != s.ID || scope.ActorID != s.ActorID {
+			return ErrConflict
+		}
+		if scope.Operation == "materialize" && (s.State == "sealed" || s.State == "handed_off") && s.PackageManifestDigest == "" && (!ok || b.State == "preparing") {
+			continue
+		}
+		if scope.Operation == "recall" && s.State == "aborting" && ok && b.State == "aborting" {
+			continue
+		}
+		return ErrConflict
+	}
+	if len(records) == 0 && repoID > 0 {
+		blocked, err := MigrationQuarantined(ctx, repoID)
+		if err != nil {
+			return err
+		}
+		if blocked {
+			return ErrConflict
+		}
+	}
+	return nil
+}
+
+// IsMigrationPackageOperation 只用于禁止隔离期通知，不授予写权限。
+func IsMigrationPackageOperation(ctx context.Context) bool {
+	_, ok := ctx.Value(migrationPackageScopeKey{}).(migrationPackageScope)
+	return ok
+}
