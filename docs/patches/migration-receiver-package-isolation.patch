+		_, e := db.GetEngine(ctx).ID(s.ID).Cols("state").Update(&governance.MigrationSession{State: "aborting"})
+		if e != nil {
+			return e
+		}
+		_, e = db.GetEngine(ctx).Where("key=?", s.BatchKey).Cols("state").Update(&governance.MigrationBatch{State: "aborting"})
+		return e
+	}))
+	s, err := Status(ctx, actor, s.Key)
+	require.NoError(t, err)
+	require.NoError(t, recallNative(ctx, actor, s))
+	_, err = packages.GetPackageByID(ctx, a.PackageID)
+	require.ErrorIs(t, err, packages.ErrPackageNotExist)
+	require.NoError(t, Abort(ctx, actor, s.Key, repo.ID, ""))
+	require.NoError(t, Abort(ctx, actor, s.Key, repo.ID, ""))
+}
