+// CreatePackageOrAddPreparedFile 供内部接收器在锁外暂存内容后原子建立引用。
+func CreatePackageOrAddPreparedFile(ctx context.Context, pvci *PackageCreationInfo, pfci *PackageFileCreationInfo, pb *packages_model.PackageBlob) (*packages_model.PackageVersion, *packages_model.PackageFile, error) {
+	if !governance_model.IsMigrationPackageOperation(ctx) {
+		return nil, nil, governance_model.ErrForbidden
+	}
+	return createPackageAndAddFile(ctx, pvci, pfci, pb, true)
+}
+func AddPreparedMigrationFile(ctx context.Context, pv *packages_model.PackageVersion, pfci *PackageFileCreationInfo, pb *packages_model.PackageBlob) (*packages_model.PackageFile, error) {
+	if !governance_model.IsMigrationPackageOperation(ctx) {
+		return nil, governance_model.ErrForbidden
+	}
+	pf, err := addFileToPackageVersionUnchecked(ctx, pv, pfci, pb)
+	if err != nil {
+		return nil, err
+	}
+	if err = packages_model.AppendFileAudit(ctx, pf, "package.file_added"); err != nil {
+		return nil, err
+	}
+	return pf, nil
+}
