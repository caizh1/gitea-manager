+// 删除保留原有命名空间清理语义，只增加迁移占用检查。
+func withMigrationRemoval(ctx context.Context, refType PropertyType, refID int64, apply func(context.Context) error) error {
+	return governance_model.WithWrite(ctx, nil, func(ctx context.Context) error {
+		packageID := refID
+		if refType == PropertyTypeFile {
+			f, ok, e := db.GetByID[PackageFile](ctx, refID)
+			if e != nil {
+				return e
+			}
+			if !ok {
+				return ErrPackageFileNotExist
+			}
+			refID = f.VersionID
+			refType = PropertyTypeVersion
+		}
+		if refType == PropertyTypeVersion {
+			v, e := GetVersionByID(ctx, refID)
+			if e != nil {
+				return e
+			}
+			packageID = v.PackageID
+		}
+		p, e := GetPackageByID(ctx, packageID)
+		if e != nil {
+			return e
+		}
+		if e = governance_model.CheckMigrationPackageWrite(ctx, p.OwnerID, string(p.Type), p.LowerName, p.ID, p.RepoID); e != nil {
+			return e
+		}
+		return apply(ctx)
+	})
+}
