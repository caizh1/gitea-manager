+	actor, err := users.GetUserByID(ctx, 1)
+	require.NoError(t, err)
+	owner, err := users.GetUserByID(ctx, 3)
+	require.NoError(t, err)
+	// 权限在预迁移开始前固定，后续测试不改变目标配置和权限。
+	require.NoError(t, db.Insert(ctx, &governance.Membership{ScopeType: "group", ScopeID: owner.ID, UserID: 2, Role: governance.Maintainer}, &governance.Membership{ScopeType: "group", ScopeID: owner.ID, UserID: 4, Role: governance.Reporter}))
+	key := strings.Repeat("9", 32)
+	repo := &repos.Repository{OwnerID: actor.ID, OwnerName: actor.Name, Name: "gm-migrate-" + key, LowerName: "gm-migrate-" + key, IsPrivate: true}
+	require.NoError(t, db.Insert(ctx, repo))
+	_, err = governance.RegisterNativeRepository(ctx, repo.ID, actor.ID, repo.Name)
+	require.NoError(t, err)
+	require.NoError(t, git.InitRepository(ctx, repo.RepoPath(), true, "sha1"))
+	session, err := Start(ctx, actor, StartOptions{Key: key, BatchKey: key, BatchSize: 1, RepoID: repo.ID, SourceDigest: strings.Repeat("8", 64)})
+	require.NoError(t, err)
+	history, err := json.Marshal(map[string]any{"name": "Review.Package", "version": "1.0.0", "type": kind})
+	require.NoError(t, err)
+	_, err = Apply(ctx, actor, key, []Object{{Kind: "package", SourceID: "package", Title: "Review.Package", Created: 1600000000, History: history}})
+	require.NoError(t, err)
+	content := []byte("来源固定内容")
+	filename := "payload.bin"
+	if kind == "nuget" {
+		var archive bytes.Buffer
+		writer := zip.NewWriter(&archive)
+		entry, err := writer.Create("Review.Package.nuspec")
+		require.NoError(t, err)
+		_, err = entry.Write([]byte(`<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd"><metadata><id>Review.Package</id><version>1.0.0</version><authors>来源作者</authors><description>未发布的内部说明</description></metadata></package>`))
+		require.NoError(t, err)
+		require.NoError(t, writer.Close())
+		content = archive.Bytes()
+		filename = "review.package.1.0.0.nupkg"
+	}
+	asset, err := Asset(ctx, actor, key, AssetOptions{SourceID: "file", Name: filename, ParentKind: "package", ParentID: "package", SHA256: fmt.Sprintf("%x", sha256.Sum256(content)), Size: int64(len(content)), Created: 1600000000}, bytes.NewReader(content))
+	require.NoError(t, err)
+	total := int64(1)
+	if len(counts) > 0 && counts[0] == 2 {
+		require.Equal(t, "nuget", kind)
+		secondHistory, err := json.Marshal(map[string]any{"name": "Review.Package", "version": "2.0.0", "type": kind})
+		require.NoError(t, err)
+		_, err = Apply(ctx, actor, key, []Object{{Kind: "package", SourceID: "package2", Title: "Review.Package", Created: 1600000000, History: secondHistory}})
+		require.NoError(t, err)
+		var second bytes.Buffer
+		zw := zip.NewWriter(&second)
+		entry, err := zw.Create("Review.Package.nuspec")
+		require.NoError(t, err)
+		_, err = entry.Write([]byte(`<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd"><metadata><id>Review.Package</id><version>2.0.0</version><authors>来源作者</authors><description>第二版本</description></metadata></package>`))
+		require.NoError(t, err)
+		require.NoError(t, zw.Close())
+		data := second.Bytes()
+		_, err = Asset(ctx, actor, key, AssetOptions{SourceID: "file2", Name: "review.package.2.0.0.nupkg", ParentKind: "package", ParentID: "package2", SHA256: fmt.Sprintf("%x", sha256.Sum256(data)), Size: int64(len(data)), Created: 1600000000}, bytes.NewReader(data))
+		require.NoError(t, err)
+		total = 2
+	}
+	require.NoError(t, sealForTest(ctx, actor, key, total, total))
+	// 与 Manager 一致，封存后先归档，再通过原生交接函数完成转移、改名及制品发布。
+	_, err = db.GetEngine(ctx).ID(repo.ID).Cols("is_archived").Update(&repos.Repository{IsArchived: true})
+	require.NoError(t, err)
+	repo, err = Handoff(ctx, actor, key, owner.ID, "review-package")
+	require.NoError(t, err)
+	session, err = Status(ctx, actor, key)
+	require.NoError(t, err)
+	_, err = db.GetEngine(ctx).ID(asset.ID).Get(asset)
+	require.NoError(t, err)
+	namespace, err := governance.GetNamespace(ctx, owner.ID)
+	require.NoError(t, err)
+	require.NoError(t, PrepareBatch(ctx, actor, key, []BatchRepo{{Key: key, RepoID: repo.ID, GroupRevision: namespace.Revision}}))
+	return ctx, actor, owner, repo, session, asset
+}
