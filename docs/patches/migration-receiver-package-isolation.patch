diff --git a/services/migrationreceiver/native_manifest.go b/services/migrationreceiver/native_manifest.go
new file mode 100644
index 0000000..e5d56e2
--- /dev/null
+++ b/services/migrationreceiver/native_manifest.go
@@ -0,0 +1,327 @@
+// Copyright 2026 Gitea.
+// SPDX-License-Identifier: MIT
+
+package migrationreceiver
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"strconv"
+	"strings"
+
+	"gitea.dev/models/db"
+	governance "gitea.dev/models/governance"
+	packages "gitea.dev/models/packages"
+	users "gitea.dev/models/user"
+	package_service "gitea.dev/services/packages"
+)
+
+type nativeSnapshot struct {
+	Rows map[string][]map[string][]byte `json:"rows"`
+	// 派生文件记录源包、生成器及原生文件编号，不充当来源附件。
+	Derived map[string]string `json:"derived"`
+}
+
+func emptyPackageDigest() string {
+	sum := sha256.Sum256([]byte("migration-native-packages-v1\n"))
+	return hex.EncodeToString(sum[:])
+}
+func nativeReceipts(ctx context.Context, s *governance.MigrationSession) ([]*governance.MigrationPackageReceipt, error) {
+	var rows []*governance.MigrationPackageReceipt
+	err := db.GetEngine(ctx).Where("session_id = ?", s.ID).OrderBy("id").Find(&rows)
+	return rows, err
+}
+func nativeDigest(rows []*governance.MigrationPackageReceipt) string {
+	h := sha256.New()
+	h.Write([]byte("migration-native-packages-v1\n"))
+	for _, r := range rows {
+		raw, _ := json.Marshal(r)
+		manifestField(h, string(raw))
+	}
+	return hex.EncodeToString(h.Sum(nil))
+}
+func saveNativeDigest(ctx context.Context, s *governance.MigrationSession) error {
+	rows, err := nativeReceipts(ctx, s)
+	if err != nil {
+		return err
+	}
+	s.PackageReceiptDigest = nativeDigest(rows)
+	s.PackageReceiptCount = int64(len(rows))
+	_, err = db.GetEngine(ctx).ID(s.ID).Cols("package_receipt_digest", "package_receipt_count").Update(s)
+	return err
+}
+func readNativeSnapshot(ctx context.Context, id int64) (map[string][]map[string][]byte, error) {
+	queries := map[string]string{
+		"package":    "SELECT * FROM package WHERE id = ? ORDER BY id",
+		"versions":   "SELECT id,package_id,creator_id,version,lower_version,created_unix,is_internal,metadata_json FROM package_version WHERE package_id = ? ORDER BY id",
+		"files":      "SELECT f.*,b.hash_sha256,b.size FROM package_file f INNER JOIN package_version v ON v.id=f.version_id INNER JOIN package_blob b ON b.id=f.blob_id WHERE v.package_id = ? ORDER BY f.id",
+		"properties": "SELECT p.* FROM package_property p WHERE (p.ref_type=2 AND p.ref_id=?) OR (p.ref_type=0 AND p.ref_id IN (SELECT id FROM package_version WHERE package_id=?)) OR (p.ref_type=1 AND p.ref_id IN (SELECT f.id FROM package_file f INNER JOIN package_version v ON v.id=f.version_id WHERE v.package_id=?)) ORDER BY p.id",
+	}
+	result := map[string][]map[string][]byte{}
+	for name, q := range queries {
+		args := []any{id}
+		if name == "properties" {
+			args = []any{id, id, id}
+		}
+		rows, err := db.GetEngine(ctx).SQL(q, args...).Query()
+		if err != nil {
+			return nil, err
+		}
+		result[name] = rows
+	}
+	if len(result["package"]) != 1 {
+		return nil, ErrConflict
+	}
+	return result, nil
+}
+func verifyNative(ctx context.Context, s *governance.MigrationSession, complete bool) error {
+	rows, err := nativeReceipts(ctx, s)
+	if err != nil {
+		return err
+	}
+	digest := nativeDigest(rows)
+	// 旧手工空夹具可读取，但存在制品的新任务必须有协议和摘要。
+	if s.Protocol != 8 {
+		if len(rows) > 0 {
+			return ErrConflict
+		}
+		return nil
+	}
+	if digest != s.PackageReceiptDigest || int64(len(rows)) != s.PackageReceiptCount {
+		return ErrConflict
+	}
+	if s.State != "aborting" && s.State != "abandoned" && s.PackageManifestDigest != "" && digest != s.PackageManifestDigest {
+		return ErrConflict
+	}
+	known := map[int64]bool{}
+	for _, r := range rows {
+		if s.State == "abandoned" && !r.Recalled {
+			return ErrConflict
+		}
+		if r.Recalled {
+			if s.State != "aborting" && s.State != "abandoned" {
+				return ErrConflict
+			}
+			var count int64
+			count, err = db.GetEngine(ctx).Table("package").Where("id=?", r.PackageID).Count()
+			if err != nil {
+				return err
+			}
+			if count != 0 {
+				return ErrConflict
+			}
+			continue
+		}
+		if r.PackageID == 0 {
+			if complete {
+				return ErrConflict
+			}
+			continue
+		}
+		known[r.PackageID] = true
+		actual, err := readNativeSnapshot(ctx, r.PackageID)
+		if err != nil {
+			return err
+		}
+		var saved nativeSnapshot
+		if json.Unmarshal([]byte(r.Data), &saved) != nil {
+			return ErrConflict
+		}
+		a, _ := json.Marshal(actual)
+		b, _ := json.Marshal(saved.Rows)
+		if string(a) != string(b) {
+			return ErrConflict
+		}
+	}
+	var actual []*packages.Package
+	if err = db.GetEngine(ctx).Where("repo_id=?", s.RepoID).Find(&actual); err != nil {
+		return err
+	}
+	for _, p := range actual {
+		if !known[p.ID] {
+			return ErrConflict
+		}
+	}
+	if complete {
+		return verifyNativeCoverage(ctx, s, rows)
+	}
+	return nil
+}
+func reserveNative(ctx context.Context, s *governance.MigrationSession, ownerID int64) error {
+	if s.Protocol != 8 {
+		return ErrConflict
+	}
+	if err := verifyNative(ctx, s, false); err != nil {
+		return err
+	}
+	var histories []*governance.MigrationHistory
+	if err := db.GetEngine(ctx).Where("session_id=? AND kind=?", s.ID, "package").OrderBy("id").Find(&histories); err != nil {
+		return err
+	}
+	for _, h := range histories {
+		var m packageManifest
+		if json.Unmarshal([]byte(h.Data), &m) != nil {
+			return ErrInvalid
+		}
+		name := strings.ToLower(m.Name)
+		var rows []*governance.MigrationPackageReceipt
+		if err := db.GetEngine(ctx).Where("owner_id=? AND type=? AND name=?", ownerID, m.Type, name).Find(&rows); err != nil {
+			return err
+		}
+		own := false
+		for _, r := range rows {
+			if r.Recalled {
+				old := &governance.MigrationSession{}
+				if _, e := db.GetEngine(ctx).ID(r.SessionID).Get(old); e != nil {
+					return e
+				}
+				if old.State == "abandoned" {
+					continue
+				}
+			}
+			if r.SessionID == s.ID {
+				own = true
+				continue
+			}
+			return ErrConflict
+		}
+		if own {
+			continue
+		}
+		exists, err := db.GetEngine(ctx).Table("package").Where("owner_id=? AND type=? AND lower_name=?", ownerID, m.Type, name).Exist()
+		if err != nil {
+			return err
+		}
+		if exists {
+			return ErrConflict
+		}
+		if err = db.Insert(ctx, &governance.MigrationPackageReceipt{SessionID: s.ID, OwnerID: ownerID, Type: m.Type, Name: name}); err != nil {
+			return err
+		}
+	}
+	return saveNativeDigest(ctx, s)
+}
+func recordNative(ctx context.Context, s *governance.MigrationSession, id, versionID int64, sourceID string, spec *preparedPackage) error {
+	var r governance.MigrationPackageReceipt
+	found, err := db.GetEngine(ctx).Where("session_id=? AND (package_id=? OR package_id=0)", s.ID, id).And("owner_id=(SELECT owner_id FROM package WHERE id=?) AND type=(SELECT type FROM package WHERE id=?) AND name=(SELECT lower_name FROM package WHERE id=?)", id, id, id).Get(&r)
+	if err != nil {
+		return err
+	}
+	if !found {
+		return ErrConflict
+	}
+	snap := nativeSnapshot{Derived: map[string]string{}}
+	if r.Data != "" && json.Unmarshal([]byte(r.Data), &snap) != nil {
+		return ErrConflict
+	}
+	snap.Rows, err = readNativeSnapshot(ctx, id)
+	if err != nil {
+		return err
+	}
+	if spec.InternalName != "" {
+		for _, f := range snap.Rows["files"] {
+			if string(f["version_id"]) == strconv.FormatInt(versionID, 10) && strings.EqualFold(string(f["name"]), spec.InternalName) {
+				snap.Derived[string(f["id"])] = sourceID + ":nuget-nuspec-v1"
+			}
+		}
+	}
+	raw, err := json.Marshal(snap)
+	if err != nil {
+		return err
+	}
+	r.PackageID = id
+	r.Data = string(raw)
+	if _, err = db.GetEngine(ctx).ID(r.ID).Cols("package_id", "data").Update(&r); err != nil {
+		return err
+	}
+	return saveNativeDigest(ctx, s)
+}
+func verifyNativeCoverage(ctx context.Context, s *governance.MigrationSession, rows []*governance.MigrationPackageReceipt) error {
+	var assets []*governance.MigrationAsset
+	if err := db.GetEngine(ctx).Where("session_id=? AND parent_kind=?", s.ID, "package").Find(&assets); err != nil {
+		return err
+	}
+	expected := map[int64]bool{}
+	for _, a := range assets {
+		if a.PackageID <= 0 || a.PackageFileID <= 0 {
+			return ErrConflict
+		}
+		expected[a.PackageFileID] = true
+	}
+	for _, r := range rows {
+		if r.Recalled {
+			continue
+		}
+		var snap nativeSnapshot
+		if json.Unmarshal([]byte(r.Data), &snap) != nil {
+			return ErrConflict
+		}
+		for _, f := range snap.Rows["files"] {
+			id, err := strconv.ParseInt(string(f["id"]), 10, 64)
+			if err != nil {
+				return err
+			}
+			if !expected[id] && snap.Derived[fmt.Sprint(id)] == "" {
+				return ErrConflict
+			}
+			delete(expected, id)
+		}
+	}
+	if len(expected) > 0 {
+		return ErrConflict
+	}
+	return nil
+}
+func freezeNative(ctx context.Context, s *governance.MigrationSession) error {
+	if err := verifyNative(ctx, s, true); err != nil {
+		return err
+	}
+	s.PackageManifestDigest = s.PackageReceiptDigest
+	_, err := db.GetEngine(ctx).ID(s.ID).Cols("package_manifest_digest").Update(s)
+	return err
+}
+
+func recallNative(ctx context.Context, actor *users.User, s *governance.MigrationSession) error {
+	rows, err := nativeReceipts(ctx, s)
+	if err != nil {
+		return err
+	}
+	for _, r := range rows {
+		err = governance.WithWrite(ctx, nil, func(ctx context.Context) error {
+			if _, e := db.GetEngine(ctx).ID(s.ID).Get(s); e != nil {
+				return e
+			}
+			if e := verifyNative(ctx, s, false); e != nil {
+				return e
+			}
+			if _, e := db.GetEngine(ctx).ID(r.ID).Get(r); e != nil {
+				return e
+			}
+			if r.Recalled {
+				return nil
+			}
+			if r.PackageID > 0 {
+				pkg, e := packages.GetPackageByID(ctx, r.PackageID)
+				if e != nil {
+					return e
+				}
+				scoped := governance.MigrationPackageContext(ctx, s.ID, actor.ID, "recall")
+				if e = package_service.RemovePackage(scoped, actor, pkg); e != nil {
+					return e
+				}
+			}
+			r.Recalled = true
+			if _, e := db.GetEngine(ctx).ID(r.ID).Cols("recalled").Update(r); e != nil {
+				return e
+			}
+			return saveNativeDigest(ctx, s)
+		})
+		if err != nil {
+			return err
+		}
+	}
+	return nil
+}
