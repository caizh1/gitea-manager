+func TestLoadingApplyAndAbortShareLockOrder(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	ctx := t.Context()
+	actor, err := users.GetUserByID(ctx, 1)
+	require.NoError(t, err)
+	key := strings.Repeat("7", 32)
+	repo := &repos.Repository{OwnerID: actor.ID, Name: "gm-migrate-" + key, LowerName: "gm-migrate-" + key, IsPrivate: true}
+	require.NoError(t, db.Insert(ctx, repo))
+	_, err = Start(ctx, actor, StartOptions{Key: key, BatchKey: key, BatchSize: 1, RepoID: repo.ID, SourceDigest: strings.Repeat("8", 64)})
+	require.NoError(t, err)
+	start := make(chan struct{})
+	done := make(chan error, 1)
+	go func() {
+		<-start
+		_, e := Apply(ctx, actor, key, []Object{{Kind: "label", SourceID: "late", Title: "并发标签", Color: "#ffffff"}})
+		done <- e
+	}()
+	close(start)
+	require.NoError(t, Abort(ctx, actor, key, repo.ID, ""))
+	<-done
+	state, err := Status(ctx, actor, key)
+	require.NoError(t, err)
+	require.Equal(t, "abandoned", state.State)
+	_, err = Apply(ctx, actor, key, []Object{{Kind: "label", SourceID: "after", Title: "终止后标签", Color: "#ffffff"}})
+	require.Error(t, err)
+}
