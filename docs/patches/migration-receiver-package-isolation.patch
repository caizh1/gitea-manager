+func TestPublicationAbortRace(t *testing.T) {
+	ctx, actor, _, repo, s, _ := reviewPackage(t, "generic")
+	ready := make(chan struct{})
+	results := make(chan error, 2)
+	go func() { <-ready; results <- PublishBatch(ctx, actor, s.Key) }()
+	go func() { <-ready; results <- Abort(ctx, actor, s.Key, repo.ID, "") }()
+	close(ready)
+	first, second := <-results, <-results
+	require.True(t, (first == nil) != (second == nil), "发布与终止不能同时成功或同时失败")
+	b, err := BatchStatus(ctx, actor, s.Key)
+	require.NoError(t, err)
+	require.Contains(t, []string{"published", "abandoned"}, b.State)
+}
