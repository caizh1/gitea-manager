+// Abort 将回收意图先持久化；原生制品与回执逐包原子回收，路径失败可继续。
+func Abort(ctx context.Context, actor *users.User, key string, repoID int64, marker string) error {
+	if actor == nil || !actor.IsAdmin || !keyPattern.MatchString(key) || repoID <= 0 {
+		return ErrInvalid
+	}
+	s := &governance.MigrationSession{}
+	found, err := db.GetEngine(ctx).Where("key = ?", key).Get(s)
+	if err != nil {
+		return err
+	}
+	if !found {
+		return abortLegacy(ctx, actor, key, repoID, marker)
+	}
+	if s.ActorID != actor.ID {
+		return ErrConflict
+	}
+	return withBatchOperation(ctx, s.BatchKey, func() error {
+		fresh, e := Status(ctx, actor, key)
+		if e != nil {
+			return e
+		}
+		s = fresh
+		if s.Protocol != 8 || !s.PublishBarrier {
+			return abortLegacy(ctx, actor, key, repoID, marker)
+		}
+		if s.SealManifestVersion == 1 {
+			if _, e := verifyManifest(ctx, s); e != nil {
+				return e
+			}
+			var assets []*governance.MigrationAsset
+			if e := db.GetEngine(ctx).Where("session_id=? AND parent_kind=?", s.ID, "package").Find(&assets); e != nil {
+				return e
+			}
+			for _, a := range assets {
+				attachment, e := repos.GetAttachmentByID(ctx, a.AttachmentID)
+				if e != nil {
+					return e
+				}
+				stream, e := storage.Attachments.Open(attachment.RelativePath())
+				if e != nil {
+					return e
+				}
+				digest := sha256.New()
+				size, e := io.Copy(digest, stream)
+				stream.Close()
+				if e != nil {
+					return e
+				}
+				if size != a.Size || fmt.Sprintf("%x", digest.Sum(nil)) != a.SHA256 {
+					return ErrConflict
+				}
+			}
+		}
+		err := governance.WithWrite(ctx, nil, func(ctx context.Context) error {
+			if e := lockBatch(ctx, actor.ID, s.BatchKey); e != nil {
+				return e
+			}
+			if _, e := db.GetEngine(ctx).ID(s.ID).Get(s); e != nil {
+				return e
+			}
+			var b governance.MigrationBatch
+			found, e := db.GetEngine(ctx).Where("key=?", s.BatchKey).Get(&b)
+			if e != nil {
+				return e
+			}
+			if !found || b.State == "published" || s.RepoID != repoID || s.ActorID != actor.ID {
+				return ErrConflict
+			}
+			repository, e := repos.GetRepositoryByID(ctx, repoID)
+			if e != nil {
+				return e
+			}
+			if !repository.IsPrivate || (repository.OwnerID != actor.ID && repository.OwnerID != s.TargetOwnerID) || (repository.Name != "gm-migrate-"+s.Key && repository.Name != s.TargetName) {
+				return ErrConflict
+			}
+			if s.State == "abandoned" {
+				r, e := repos.GetRepositoryByID(ctx, repoID)
+				if e != nil {
+					return e
+				}
+				if !r.IsPrivate || !r.IsArchived || r.OwnerID != actor.ID || r.Name != "gm-migrate-"+s.Key {
+					return ErrConflict
+				}
+				return verifyNative(ctx, s, false)
+			}
+			if s.State != "loading" && s.State != "sealed" && s.State != "handed_off" && s.State != "aborting" {
+				return ErrConflict
+			}
+			if e := verifyNative(ctx, s, s.State == "handed_off"); e != nil {
+				return e
+			}
+			if _, e = db.GetEngine(ctx).Where("key=?", s.BatchKey).Cols("state").Update(&governance.MigrationBatch{State: "aborting"}); e != nil {
+				return e
+			}
+			s.State = "aborting"
+			_, e = db.GetEngine(ctx).ID(s.ID).Cols("state").Incr("revision").Update(s)
+			return e
+		})
+		if err != nil {
+			return err
+		}
+		if s.State == "abandoned" {
+			return nil
+		}
+		if err = recallNative(ctx, actor, s); err != nil {
+			return err
+		}
+		repo, err := repos.GetRepositoryByID(ctx, repoID)
+		if err != nil {
+			return err
+		}
+		if !repo.IsPrivate || (repo.OwnerID != actor.ID && repo.OwnerID != s.TargetOwnerID) {
+			return ErrConflict
+		}
+		if err = recallPrepared(ctx, actor, s, repo); err != nil {
+			return err
+		}
+		return governance.WithWrite(ctx, nil, func(ctx context.Context) error {
+			if e := lockBatch(ctx, actor.ID, s.BatchKey); e != nil {
+				return e
+			}
+			s.State = "abandoned"
+			if e := verifyNative(ctx, s, false); e != nil {
+				return e
+			}
+			if _, e := db.GetEngine(ctx).ID(repoID).Cols("is_archived").Update(&repos.Repository{IsArchived: true}); e != nil {
+				return e
+			}
+			if _, e := db.GetEngine(ctx).ID(s.ID).Cols("state").Incr("revision").Update(s); e != nil {
+				return e
+			}
+			remaining, e := db.GetEngine(ctx).Where("batch_key=? AND state<>?", s.BatchKey, "abandoned").Count(new(governance.MigrationSession))
+			if e != nil {
+				return e
+			}
+			if remaining == 0 {
+				_, e = db.GetEngine(ctx).Where("key=?", s.BatchKey).Cols("state").Update(&governance.MigrationBatch{State: "abandoned"})
+			}
+			return e
+		})
+	})
+}
