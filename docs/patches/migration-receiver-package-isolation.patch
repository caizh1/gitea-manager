+// 使用真实导入、附件、原生交接和制品发布服务，不伪造制品回执。
+func reviewPackage(t *testing.T, kind string, counts ...int) (context.Context, *users.User, *users.User, *repos.Repository, *governance.MigrationSession, *governance.MigrationAsset) {
+	require.NoError(t, unittest.PrepareTestDatabase())
