@@ -0,0 +1,164 @@
+// Copyright 2026 Gitea.
+// SPDX-License-Identifier: MIT
+
+package migrationreceiver
+
+import (
+	"context"
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"io"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"gitea.dev/models/db"
+	governance "gitea.dev/models/governance"
+	packages "gitea.dev/models/packages"
+	repos "gitea.dev/models/repo"
+	"gitea.dev/models/unittest"
+	users "gitea.dev/models/user"
+	"gitea.dev/modules/setting"
+
+	"github.com/stretchr/testify/require"
+	"xorm.io/xorm"
+	"xorm.io/xorm/contexts"
+	"xorm.io/xorm/names"
+)
+
+type abortReadFault struct {
+	err   error
+	fired bool
+}
+
+func (f *abortReadFault) BeforeProcess(c *contexts.ContextHook) (context.Context, error) {
+	if !f.fired && strings.HasPrefix(strings.ToUpper(c.SQL), "SELECT") && strings.Contains(c.SQL, "governance_migration_session") {
+		f.fired = true
+		return c.Ctx, f.err
+	}
+	return c.Ctx, nil
+}
+
+func (*abortReadFault) AfterProcess(*contexts.ContextHook) error { return nil }
+
+// 仅显式指定本机独立测试库时切换，禁止误用真实业务数据库。
+func abortRegressionDatabase(t *testing.T) {
+	t.Helper()
+	dsn := os.Getenv("GITEA_TEST_MIGRATION_ABORT_DSN")
+	if dsn == "" {
+		return
+	}
+	u, err := url.Parse(dsn)
+	require.NoError(t, err)
+	require.Contains(t, []string{"127.0.0.1", "localhost"}, u.Hostname())
+	require.Equal(t, "/migration_abort_test", u.Path)
+	engine, err := xorm.NewEngine("postgres", dsn)
+	require.NoError(t, err)
+	engine.SetMapper(names.GonicMapper{})
+	original, databaseType := db.GetXORMEngineForTesting(), setting.Database.Type
+	fixtures := unittest.FixturesOptions{Dir: filepath.Join(setting.GetGiteaTestSourceRoot(), "models", "fixtures")}
+	t.Cleanup(func() {
+		db.SetDefaultEngine(context.Background(), original)
+		setting.Database.Type = databaseType
+		require.NoError(t, unittest.InitFixtures(fixtures))
+		require.NoError(t, engine.Close())
+	})
+	db.SetDefaultEngine(context.Background(), engine)
+	setting.Database.Type = "postgres"
+	version, err := engine.QueryString("SELECT version()")
+	require.NoError(t, err)
+	require.Len(t, version, 1)
+	require.Contains(t, version[0]["version"], "PostgreSQL 16.8")
+	t.Logf("定向回归数据库：%s", version[0]["version"])
+	require.NoError(t, db.SyncAllTables())
+	require.NoError(t, unittest.InitFixtures(fixtures))
+}
+
+func TestAbortRegression(t *testing.T) {
+	abortRegressionDatabase(t)
+	t.Run("会话读取失败保持原状态并允许重试", func(t *testing.T) {
+		ctx, actor, _, repo, session, asset := reviewPackage(t, "nuget", 2)
+		fault := &abortReadFault{err: errors.New("故障注入：会话读取暂时失败")}
+		db.GetXORMEngineForTesting().AddHook(fault)
+		require.ErrorIs(t, Abort(ctx, actor, session.Key, repo.ID, ""), fault.err)
+		require.True(t, fault.fired)
+		fresh, err := Status(ctx, actor, session.Key)
+		require.NoError(t, err)
+		require.Equal(t, "handed_off", fresh.State)
+		require.Equal(t, session.PackageReceiptDigest, fresh.PackageReceiptDigest)
+		batch, err := BatchStatus(ctx, actor, session.BatchKey)
+		require.NoError(t, err)
+		require.Equal(t, "prepared", batch.State)
+		_, err = packages.GetPackageByID(ctx, asset.PackageID)
+		require.NoError(t, err)
+		require.NoError(t, Abort(ctx, actor, session.Key, repo.ID, ""))
+		require.NoError(t, Abort(ctx, actor, session.Key, repo.ID, ""))
+		_, err = packages.GetPackageByID(ctx, asset.PackageID)
+		require.ErrorIs(t, err, packages.ErrPackageNotExist)
+		fresh, err = Status(ctx, actor, session.Key)
+		require.NoError(t, err)
+		require.Equal(t, "abandoned", fresh.State)
+		rows, err := nativeReceipts(ctx, fresh)
+		require.NoError(t, err)
+		require.NotEmpty(t, rows)
+		for _, row := range rows {
+			require.True(t, row.Recalled)
+		}
+		_, stream, err := OpenAsset(ctx, actor, session.Key, asset.ID)
+		require.NoError(t, err)
+		defer stream.Close()
+		content, err := io.ReadAll(stream)
+		require.NoError(t, err)
+		require.Equal(t, asset.SHA256, fmt.Sprintf("%x", sha256.Sum256(content)))
+	})
+	t.Run("旧终止分支不得接管新会话", func(t *testing.T) {
+		ctx, actor, _, repo, session, asset := reviewPackage(t, "nuget")
+		// 覆盖初次查询不存在、等待治理锁时另一请求已提交会话的窗口。
+		require.ErrorIs(t, abortLegacy(ctx, actor, session.Key, repo.ID, ""), ErrConflict)
+		fresh, err := Status(ctx, actor, session.Key)
+		require.NoError(t, err)
+		require.Equal(t, "handed_off", fresh.State)
+		_, err = packages.GetPackageByID(ctx, asset.PackageID)
+		require.NoError(t, err)
+	})
+	t.Run("未完成回收不能冒充终态", func(t *testing.T) {
+		ctx, actor, _, repo, session, _ := reviewPackage(t, "nuget")
+		// 固定旧错误分支留下的现场，只验证阻断，不自动补录或回收旧现场。
+		require.NoError(t, recallPrepared(ctx, actor, session, repo))
+		require.NoError(t, governance.WithWrite(ctx, nil, func(ctx context.Context) error {
+			if _, err := db.GetEngine(ctx).ID(session.ID).Cols("state").Update(&governance.MigrationSession{State: "abandoned"}); err != nil {
+				return err
+			}
+			_, err := db.GetEngine(ctx).Where("key=?", session.BatchKey).Cols("state").Update(&governance.MigrationBatch{State: "abandoned"})
+			return err
+		}))
+		require.ErrorIs(t, Abort(ctx, actor, session.Key, repo.ID, ""), ErrConflict)
+	})
+	t.Run("未创建会话按确切标记收尾", func(t *testing.T) {
+		require.NoError(t, unittest.PrepareTestDatabase())
