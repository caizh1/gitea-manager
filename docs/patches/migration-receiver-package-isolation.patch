@@ -0,0 +1,45 @@
+// Copyright 2026 Gitea.
+// SPDX-License-Identifier: MIT
+
+package migrationreceiver
+
+import (
+	"context"
+	"gitea.dev/modules/setting"
+	"golang.org/x/sys/unix"
+	"os"
+	"path/filepath"
+	"time"
+)
+
+// 单节点持久卷上的批次锁跨进程有效，崩溃由内核释放，不按时间抢占活跃操作。
+func withBatchOperation(ctx context.Context, key string, apply func() error) error {
+	if !keyPattern.MatchString(key) {
+		return ErrInvalid
+	}
+	directory := filepath.Join(setting.AppDataPath, "migration-locks")
+	if err := os.MkdirAll(directory, 0700); err != nil {
+		return err
+	}
+	f, err := os.OpenFile(filepath.Join(directory, key+".lock"), os.O_CREATE|os.O_RDWR, 0600)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	for {
+		err = unix.Flock(int(f.Fd()), unix.LOCK_EX|unix.LOCK_NB)
+		if err == nil {
+			break
+		}
+		if err != unix.EWOULDBLOCK && err != unix.EAGAIN {
+			return err
+		}
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(25 * time.Millisecond):
+		}
+	}
+	defer unix.Flock(int(f.Fd()), unix.LOCK_UN)
+	return apply()
+}
