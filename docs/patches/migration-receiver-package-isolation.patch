+func TestBatchOperationCrossProcess(t *testing.T) {
+	if folder := os.Getenv("GM_LOCK_TEST_FOLDER"); folder != "" {
+		setting.AppDataPath = folder
+		ctx, cancel := context.WithTimeout(t.Context(), 500*time.Millisecond)
+		defer cancel()
+		called := false
+		err := withBatchOperation(ctx, strings.Repeat("f", 32), func() error { called = true; return nil })
+		if os.Getenv("GM_LOCK_EXPECT_BLOCKED") == "yes" {
+			require.ErrorIs(t, err, context.DeadlineExceeded, "父进程持锁时子进程必须被实际阻断")
+			require.False(t, called, "被阻断的子进程不得进入操作")
+		} else {
+			require.NoError(t, err)
+			require.True(t, called, "父进程释放后子进程应能获取同一个锁")
+		}
+		return
+	}
+	folder := t.TempDir()
+	old := setting.AppDataPath
+	setting.AppDataPath = folder
+	t.Cleanup(func() { setting.AppDataPath = old })
+	child := func(blocked string) {
+		cmd := exec.Command(os.Args[0], "-test.run=^TestBatchOperationCrossProcess$")
+		cmd.Env = append(os.Environ(), "GM_LOCK_TEST_FOLDER="+folder, "GM_LOCK_EXPECT_BLOCKED="+blocked)
+		output, err := cmd.CombinedOutput()
+		require.NoError(t, err, string(output))
+	}
+	require.NoError(t, withBatchOperation(t.Context(), strings.Repeat("f", 32), func() error { child("yes"); return nil }))
+	child("no")
+}
