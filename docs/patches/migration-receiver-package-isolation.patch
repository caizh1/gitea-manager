+func TestSealedSourceAttachmentRejectsStaleNativeMutation(t *testing.T) {
+	ctx, actor, _, repo, s, a := reviewPackage(t, "generic")
+	attachment, err := repos.GetAttachmentByID(ctx, a.AttachmentID)
