diff --git a/services/migrationreceiver/discussion_snapshot.go b/services/migrationreceiver/discussion_snapshot.go
new file mode 100644
index 0000000..d59c6a0
--- /dev/null
+++ b/services/migrationreceiver/discussion_snapshot.go
@@ -0,0 +1,303 @@
+// Copyright 2026 Gitea.
+// SPDX-License-Identifier: MIT
+
+package migrationreceiver
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"strings"
+
+	"gitea.dev/models/db"
+	governance "gitea.dev/models/governance"
+	issues "gitea.dev/models/issues"
+	repos "gitea.dev/models/repo"
+)
+
+type DiscussionNote struct {
+	SourceID   string          `json:"source_id"`
+	Kind       string          `json:"kind"`
+	Resolvable *bool           `json:"resolvable,omitempty"`
+	Resolved   *bool           `json:"resolved,omitempty"`
+	ResolvedBy json.RawMessage `json:"resolved_by,omitempty"`
+	ResolvedAt json.RawMessage `json:"resolved_at,omitempty"`
+}
+
+type DiscussionHistory struct {
+	ThreadID       string           `json:"thread_id"`
+	ParentKind     string           `json:"parent_kind"`
+	ParentSourceID string           `json:"parent_source_id"`
+	IndividualNote *bool            `json:"individual_note,omitempty"`
+	Notes          []DiscussionNote `json:"notes"`
+}
+
+type DiscussionBadge struct {
+	HistoryID int64
+	State     string
+}
+
+// 只读视图不改写原始 JSON；缺失字段与来源显式空值分开显示。
+type DiscussionNoteView struct {
+	SourceID, State, Resolvable, Resolved, ResolvedBy, ResolvedAt string
+	TargetURL                                                     string
+	Deleted                                                       bool
+}
+
+type DiscussionView struct {
+	ThreadID, ParentURL, ParentLabel string
+	Notes                            []DiscussionNoteView
+}
+
+func sourceValue(fields map[string]json.RawMessage, key string) string {
+	raw, exists := fields[key]
+	if !exists {
+		return "来源未提供"
+	}
+	var value any
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.UseNumber()
+	if decoder.Decode(&value) != nil {
+		return string(raw)
+	}
+	if value == nil {
+		return "来源返回空值"
+	}
+	switch v := value.(type) {
+	case string:
+		if v == "" {
+			return "来源返回空值"
+		}
+		return v
+	case bool:
+		if v {
+			return "是"
+		}
+		return "否"
+	case map[string]any:
+		if key == "resolved_by" {
+			parts := []string{}
+			for _, field := range []string{"name", "username", "id"} {
+				if item, ok := v[field]; ok && item != nil && fmt.Sprint(item) != "" {
+					parts = append(parts, map[string]string{"name": "姓名：", "username": "用户名：", "id": "来源编号："}[field]+fmt.Sprint(item))
+				}
+			}
+			if len(parts) > 0 {
+				return strings.Join(parts, " · ")
+			}
+		}
+	}
+	return string(raw)
+}
+
+func discussionState(note DiscussionNote) string {
+	if note.Resolvable != nil {
+		if !*note.Resolvable {
+			return "不可解决"
+		}
+		if note.Resolved != nil {
+			if *note.Resolved {
+				return "已解决"
+			}
+			return "待解决"
+		}
+	}
+	return "来源未提供状态"
+}
+
+func DiscussionDetails(ctx context.Context, history *governance.MigrationHistory) (*DiscussionView, error) {
+	parent, err := DiscussionParent(ctx, history)
+	if err != nil {
+		return nil, err
+	}
+	if err = parent.LoadRepo(ctx); err != nil {
+		return nil, err
+	}
+	var source DiscussionHistory
+	if err = json.Unmarshal([]byte(history.Data), &source); err != nil {
+		return nil, err
+	}
+	var raw struct {
+		Notes []map[string]json.RawMessage `json:"notes"`
+	}
+	if err = json.Unmarshal([]byte(history.Data), &raw); err != nil {
+		return nil, err
+	}
+	view := &DiscussionView{ThreadID: source.ThreadID, ParentURL: parent.Link(), ParentLabel: "议题"}
+	if parent.IsPull {
+		view.ParentLabel = "PR"
+	}
+	for index, note := range source.Notes {
+		fields := raw.Notes[index]
+		item := DiscussionNoteView{SourceID: note.SourceID, State: discussionState(note),
+			Resolvable: sourceValue(fields, "resolvable"), Resolved: sourceValue(fields, "resolved"),
+			ResolvedBy: sourceValue(fields, "resolved_by"), ResolvedAt: sourceValue(fields, "resolved_at")}
+		id, err := dependency(ctx, history.SessionID, note.Kind, note.SourceID)
+		if err != nil {
+			return nil, err
+		}
+		comment, err := issues.GetCommentByID(ctx, id)
+		if issues.IsErrCommentNotExist(err) {
+			item.Deleted = true
+		} else if err != nil {
+			return nil, err
+		} else {
+			expected := issues.CommentTypeComment
+			if note.Kind == "code_comment" {
+				expected = issues.CommentTypeCode
+			}
+			if comment.IssueID != parent.ID || comment.Type != expected {
+				return nil, ErrConflict
+			}
+			item.TargetURL = comment.Link(ctx)
+		}
+		view.Notes = append(view.Notes, item)
+	}
+	return view, nil
+}
+
+func validateDiscussionSnapshot(o Object) error {
+	var h DiscussionHistory
+	if o.SourceID == "" || len(o.SourceID) > 100 || o.Created <= 0 || len(o.History) > 4*1024*1024 || json.Unmarshal(o.History, &h) != nil || h.ThreadID != o.SourceID || h.ParentSourceID != o.ParentID || h.ParentKind != o.ParentKind || (h.ParentKind != "pull" && h.ParentKind != "issue") || len(h.Notes) == 0 {
+		return ErrInvalid
+	}
+	seen := map[string]bool{}
+	for _, n := range h.Notes {
+		if n.SourceID == "" || len(n.SourceID) > 100 || seen[n.SourceID] || (n.Kind != "comment" && n.Kind != "code_comment") {
+			return ErrInvalid
+		}
+		seen[n.SourceID] = true
+	}
+	return nil
+}
+
+// 同时核对父对象与每条评论回执，不能把其他议题的评论接入本线程。
+func discussionLinks(ctx context.Context, s *governance.MigrationSession, h *DiscussionHistory) (int64, map[int64]DiscussionNote, error) {
+	parent, err := dependency(ctx, s.ID, h.ParentKind, h.ParentSourceID)
+	if err != nil {
+		return 0, nil, err
+	}
+	issue, err := issues.GetIssueByID(ctx, parent)
+	if err != nil {
+		return 0, nil, err
+	}
+	if issue.RepoID != s.RepoID || issue.IsPull != (h.ParentKind == "pull") {
+		return 0, nil, ErrConflict
+	}
+	result := map[int64]DiscussionNote{}
+	for _, n := range h.Notes {
+		id, err := dependency(ctx, s.ID, n.Kind, n.SourceID)
+		if err != nil {
+			return 0, nil, err
+		}
+		c, err := issues.GetCommentByID(ctx, id)
+		if err != nil {
+			return 0, nil, err
+		}
+		expected := issues.CommentTypeComment
+		if n.Kind == "code_comment" {
+			expected = issues.CommentTypeCode
+		}
+		if c.IssueID != parent || c.Type != expected {
+			return 0, nil, ErrConflict
+		}
+		result[id] = n
+	}
+	return parent, result, nil
+}
+
+func insertDiscussionSnapshot(ctx context.Context, repo *repos.Repository, s *governance.MigrationSession, o Object) (int64, error) {
+	var h DiscussionHistory
+	if err := json.Unmarshal(o.History, &h); err != nil {
+		return 0, err
+	}
+	if _, _, err := discussionLinks(ctx, s, &h); err != nil {
+		return 0, err
+	}
+	record := &governance.MigrationHistory{RepoID: repo.ID, SessionID: s.ID, SourceID: o.SourceID, Kind: o.Kind, Name: o.Title, ParentID: o.ParentID, Created: o.Created, Data: string(o.History)}
+	_, err := db.GetEngine(ctx).Insert(record)
+	return record.ID, err
+}
+
+func verifyDiscussionSnapshot(ctx context.Context, s *governance.MigrationSession, r *governance.MigrationReceipt, o Object) (bool, error) {
+	h := &governance.MigrationHistory{}
+	found, err := db.GetEngine(ctx).ID(r.TargetID).Get(h)
+	if err != nil || !found {
+		return false, err
+	}
+	if h.RepoID != s.RepoID || h.SessionID != s.ID || h.Kind != o.Kind || h.SourceID != o.SourceID || h.ParentID != o.ParentID || h.Name != o.Title || h.Created != o.Created || !sameHistory(h.Data, o.History) {
+		return false, nil
+	}
+	var value DiscussionHistory
+	if err = json.Unmarshal([]byte(h.Data), &value); err != nil {
+		return false, err
+	}
+	_, _, err = discussionLinks(ctx, s, &value)
+	return err == nil, err
+}
+
+// 历史入口根据实际父议题确定权限，不能沿用代码读取权限。
+func DiscussionParent(ctx context.Context, h *governance.MigrationHistory) (*issues.Issue, error) {
+	var value DiscussionHistory
+	if err := json.Unmarshal([]byte(h.Data), &value); err != nil {
+		return nil, err
+	}
+	id, err := dependency(ctx, h.SessionID, value.ParentKind, value.ParentSourceID)
+	if err != nil {
+		return nil, err
+	}
+	issue, err := issues.GetIssueByID(ctx, id)
+	if err != nil {
+		return nil, err
+	}
+	if issue.RepoID != h.RepoID || issue.IsPull != (value.ParentKind == "pull") {
+		return nil, ErrConflict
+	}
+	return issue, nil
+}
+
+func DiscussionBadges(ctx context.Context, issue *issues.Issue) (map[int64]DiscussionBadge, error) {
+	records := []*governance.MigrationHistory{}
+	parentKind := "issue"
+	if issue.IsPull {
+		parentKind = "pull"
+	}
+	receipt := &governance.MigrationReceipt{}
+	found, err := db.GetEngine(ctx).Where("target_id = ? AND kind = ?", issue.ID, parentKind).Get(receipt)
+	if err != nil {
+		return nil, err
+	}
+	if !found {
+		return map[int64]DiscussionBadge{}, nil
+	}
+	if err := db.GetEngine(ctx).Where("repo_id = ? AND kind = ? AND session_id = ? AND parent_id = ?", issue.RepoID, "discussion_snapshot", receipt.SessionID, receipt.SourceID).Find(&records); err != nil {
+		return nil, err
+	}
+	result := map[int64]DiscussionBadge{}
+	for _, record := range records {
+		parent, err := DiscussionParent(ctx, record)
+		if err != nil {
+			return nil, err
+		}
+		if parent.ID != issue.ID {
+			continue
+		}
+		var value DiscussionHistory
+		if err = json.Unmarshal([]byte(record.Data), &value); err != nil {
+			return nil, err
+		}
+		for _, note := range value.Notes {
+			id, err := dependency(ctx, record.SessionID, note.Kind, note.SourceID)
+			if err != nil {
+				return nil, err
+			}
+			state := discussionState(note)
+			if _, ok := result[id]; ok {
+				return nil, fmt.Errorf("重复的来源讨论关联")
+			}
+			result[id] = DiscussionBadge{HistoryID: record.ID, State: state}
+		}
+	}
+	return result, nil
+}
