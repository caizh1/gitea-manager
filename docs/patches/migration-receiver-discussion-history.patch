diff --git a/routers/web/repo/migration_history_test.go b/routers/web/repo/migration_history_test.go
new file mode 100644
index 0000000..21ce301
--- /dev/null
+++ b/routers/web/repo/migration_history_test.go
@@ -0,0 +1,71 @@
+// Copyright 2026 Gitea.
+// SPDX-License-Identifier: MIT
+
+package repo
+
+import (
+	"fmt"
+	"testing"
+
+	"gitea.dev/models/db"
+	governance "gitea.dev/models/governance"
+	issues "gitea.dev/models/issues"
+	"gitea.dev/models/unittest"
+	"gitea.dev/services/contexttest"
+	"gitea.dev/services/migrationreceiver"
+	"github.com/stretchr/testify/require"
+)
+
+func historyFixture(t *testing.T) *governance.MigrationHistory {
+	t.Helper()
+	require.NoError(t, unittest.PrepareTestDatabase())
+	parent := unittest.AssertExistsAndLoadBean(t, &issues.Issue{ID: 1})
+	receipt := &governance.MigrationReceipt{SessionID: 777, Kind: "issue", SourceID: "source-issue", TargetID: parent.ID}
+	require.NoError(t, db.Insert(t.Context(), receipt))
+	record := &governance.MigrationHistory{SessionID: 777, RepoID: parent.RepoID, Kind: "discussion_snapshot", SourceID: "thread-1", ParentID: "source-issue", Data: `{"thread_id":"thread-1","parent_kind":"issue","parent_source_id":"source-issue","notes":[{"source_id":"note-1","kind":"comment","resolvable":true,"resolved":false}]}`}
+	require.NoError(t, db.Insert(t.Context(), record))
+	require.NoError(t, db.Insert(t.Context(), &governance.MigrationReceipt{SessionID: 777, Kind: "comment", SourceID: "note-1", TargetID: 987654321}))
+	return record
+}
+
+func TestMigrationHistoryDeletedParentIsHidden(t *testing.T) {
+	record := historyFixture(t)
+	_, err := db.GetEngine(t.Context()).ID(1).Delete(new(issues.Issue))
+	require.NoError(t, err)
+	ctx, response := contexttest.MockContext(t, "/user2/repo1/migration-history")
+	contexttest.LoadUser(t, ctx, 2)
+	contexttest.LoadRepo(t, ctx, 1)
+	ctx.SetPathParam("id", fmt.Sprint(record.ID))
+	MigrationHistory(ctx)
+	require.Equal(t, 404, response.Code, "父对象删除后应隐藏历史详情")
+	found, err := db.GetEngine(t.Context()).ID(record.ID).Exist(new(governance.MigrationHistory))
+	require.NoError(t, err)
+	require.True(t, found)
+}
+
+func TestMigrationHistoryDeletedParentDoesNotBreakList(t *testing.T) {
+	historyFixture(t)
+	_, err := db.GetEngine(t.Context()).ID(1).Delete(new(issues.Issue))
+	require.NoError(t, err)
+	ctx, response := contexttest.MockContext(t, "/user2/repo1/migration-history")
+	contexttest.LoadUser(t, ctx, 2)
+	contexttest.LoadRepo(t, ctx, 1)
+	MigrationHistory(ctx)
+	require.Equal(t, 200, response.Code, "删除的父对象不能阻断整个历史列表")
+	require.Empty(t, ctx.Data["MigrationRows"])
+}
+
+func TestMigrationHistoryStructuredDiscussion(t *testing.T) {
+	record := historyFixture(t)
+	ctx, _ := contexttest.MockContext(t, "/user2/repo1/migration-history")
+	contexttest.LoadUser(t, ctx, 2)
+	contexttest.LoadRepo(t, ctx, 1)
+	ctx.SetPathParam("id", fmt.Sprint(record.ID))
+	MigrationHistory(ctx)
+	require.NotNil(t, ctx.Data["MigrationDiscussion"], "线程详情必须提供结构化展示，不能仅有原始 JSON")
+	view := ctx.Data["MigrationDiscussion"].(*migrationreceiver.DiscussionView)
+	require.Equal(t, "thread-1", view.ThreadID)
+	require.Equal(t, "待解决", view.Notes[0].State)
+	require.Equal(t, "来源未提供", view.Notes[0].ResolvedBy)
+	require.True(t, view.Notes[0].Deleted)
+}
