diff --git a/services/migrationreceiver/manifest.go b/services/migrationreceiver/manifest.go
new file mode 100644
index 0000000..f59b8a4
--- /dev/null
+++ b/services/migrationreceiver/manifest.go
@@ -0,0 +1,156 @@
+// Copyright 2026 Gitea.
+// SPDX-License-Identifier: MIT
+
+package migrationreceiver
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"hash"
+	"strconv"
+
+	"gitea.dev/models/db"
+	governance "gitea.dev/models/governance"
+	issues "gitea.dev/models/issues"
+	repos "gitea.dev/models/repo"
+	users "gitea.dev/models/user"
+)
+
+type ManifestSummary struct {
+	Version  int    `json:"version"`
+	Objects  int64  `json:"objects"`
+	Assets   int64  `json:"assets"`
+	Digest   string `json:"digest"`
+	Revision int64  `json:"revision,omitempty"`
+}
+
+// 每字段使用八字节大端长度和 UTF-8 原文，避免跨语言 JSON 编码差异。
+func manifestField(h hash.Hash, value string) {
+	var size [8]byte
+	binary.BigEndian.PutUint64(size[:], uint64(len([]byte(value))))
+	h.Write(size[:])
+	h.Write([]byte(value))
+}
+func metadataDigest(opt AssetOptions) string {
+	h := sha256.New()
+	for _, v := range []string{"gitea-migration-asset-v1", opt.SourceID, opt.Name, opt.ParentKind, opt.ParentID, opt.SHA256, strconv.FormatInt(opt.Size, 10), strconv.FormatInt(opt.Created, 10)} {
+		manifestField(h, v)
+	}
+	return hex.EncodeToString(h.Sum(nil))
+}
+
+func manifest(ctx context.Context, s *governance.MigrationSession) (*ManifestSummary, error) {
+	var receipts []*governance.MigrationReceipt
+	var assets []*governance.MigrationAsset
+	if err := db.GetEngine(ctx).Where("session_id = ?", s.ID).OrderBy("id").Find(&receipts); err != nil {
+		return nil, err
+	}
+	if err := db.GetEngine(ctx).Where("session_id = ?", s.ID).OrderBy("id").Find(&assets); err != nil {
+		return nil, err
+	}
+	h := sha256.New()
+	manifestField(h, "gitea-migration-manifest-v1")
+	manifestField(h, strconv.Itoa(len(receipts)))
+	for _, r := range receipts {
+		sum := sha256.Sum256([]byte(r.Payload))
+		var o Object
+		if json.Unmarshal([]byte(r.Payload), &o) != nil || o.Kind != r.Kind || o.SourceID != r.SourceID || hex.EncodeToString(sum[:]) != r.Digest {
+			return nil, ErrConflict
+		}
+		valid, err := verify(ctx, s, r)
+		if err != nil {
+			return nil, err
+		}
+		if !valid {
+			return nil, ErrConflict
+		}
+		for _, v := range []string{strconv.FormatInt(r.ID, 10), r.Kind, r.SourceID, strconv.FormatInt(r.TargetID, 10), r.Digest} {
+			manifestField(h, v)
+		}
+	}
+	manifestField(h, strconv.Itoa(len(assets)))
+	for _, a := range assets {
+		var opt AssetOptions
+		if json.Unmarshal([]byte(a.Metadata), &opt) != nil || a.SourceID != opt.SourceID || a.ParentKind != opt.ParentKind || a.ParentID != opt.ParentID || a.Size != opt.Size || a.SHA256 != opt.SHA256 || a.AttachmentID <= 0 {
+			return nil, ErrConflict
+		}
+		attachment, err := repos.GetAttachmentByID(ctx, a.AttachmentID)
+		if err != nil {
+			return nil, err
+		}
+		if attachment.RepoID != s.RepoID || attachment.UUID != a.UUID || attachment.Name != opt.Name || attachment.Size != opt.Size || int64(attachment.CreatedUnix) != opt.Created {
+			return nil, ErrConflict
+		}
+		parent, err := dependency(ctx, s.ID, opt.ParentKind, opt.ParentID)
+		if err != nil {
+			return nil, err
+		}
+		switch opt.ParentKind {
+		case "release":
+			if attachment.ReleaseID != parent || attachment.IssueID != 0 || attachment.CommentID != 0 {
+				return nil, ErrConflict
+			}
+		case "issue", "pull":
+			if attachment.IssueID != parent || attachment.CommentID != 0 || attachment.ReleaseID != 0 {
+				return nil, ErrConflict
+			}
+		case "comment", "code_comment":
+			comment, err := issues.GetCommentByID(ctx, parent)
+			if err != nil {
+				return nil, err
+			}
+			if attachment.CommentID != parent || attachment.IssueID != comment.IssueID || attachment.ReleaseID != 0 {
+				return nil, ErrConflict
+			}
+		default:
+			if attachment.IssueID != 0 || attachment.CommentID != 0 || attachment.ReleaseID != 0 {
+				return nil, ErrConflict
+			}
+		}
+		for _, v := range []string{strconv.FormatInt(a.ID, 10), a.SourceID, a.ParentKind, a.ParentID, metadataDigest(opt), strconv.FormatInt(a.Size, 10), a.SHA256, a.UUID, strconv.FormatInt(a.AttachmentID, 10)} {
+			manifestField(h, v)
+		}
+	}
+	return &ManifestSummary{Version: 1, Objects: int64(len(receipts)), Assets: int64(len(assets)), Digest: hex.EncodeToString(h.Sum(nil)), Revision: s.Revision}, nil
+}
+func verifyManifest(ctx context.Context, s *governance.MigrationSession) (*ManifestSummary, error) {
+	actual, err := manifest(ctx, s)
+	if err != nil {
+		return nil, err
+	}
+	if s.SealManifestVersion != 1 || s.SealManifestDigest != actual.Digest {
+		return nil, ErrConflict
+	}
+	return actual, nil
+}
+
+// 在同一事务内领取会话锁，避免分页式读回混入不同修订。
+func Manifest(ctx context.Context, actor *users.User, key string) (*ManifestSummary, error) {
+	var result *ManifestSummary
+	err := db.WithTx(ctx, func(ctx context.Context) error {
+		s, err := Status(ctx, actor, key)
+		if err != nil {
+			return err
+		}
+		if err = readableSession(ctx, actor, s); err != nil {
+			return err
+		}
+		n, err := db.GetEngine(ctx).Table(s).Where("id = ? AND revision = ?", s.ID, s.Revision).Update(map[string]any{"revision": s.Revision})
+		if err != nil {
+			return err
+		}
+		if n != 1 {
+			return ErrConflict
+		}
+		if s.State == "loading" {
+			result, err = manifest(ctx, s)
+		} else {
+			result, err = verifyManifest(ctx, s)
+		}
+		return err
+	})
+	return result, err
+}
