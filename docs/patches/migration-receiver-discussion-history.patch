+// Copyright 2026 Gitea.
+// SPDX-License-Identifier: MIT
+
+package migrationreceiver
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"gitea.dev/models/db"
+	governance "gitea.dev/models/governance"
+	issues "gitea.dev/models/issues"
+	repos "gitea.dev/models/repo"
+	"gitea.dev/models/unittest"
+	users "gitea.dev/models/user"
+	"github.com/stretchr/testify/require"
+)
+
+func TestDiscussionSnapshotReplayAndIndependentVerification(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	ctx := t.Context()
+	actor, err := users.GetUserByID(ctx, 1)
+	require.NoError(t, err)
+	key := strings.Repeat("f", 32)
+	repo := &repos.Repository{OwnerID: actor.ID, OwnerName: actor.Name, Name: "gm-migrate-" + key, LowerName: "gm-migrate-" + key, IsPrivate: true}
+	require.NoError(t, db.Insert(ctx, repo))
+	_, err = Start(ctx, actor, StartOptions{Key: key, RepoID: repo.ID, SourceDigest: strings.Repeat("a", 64)})
+	require.NoError(t, err)
+	history := json.RawMessage(`{"thread_id":"thread-1","parent_kind":"issue","parent_source_id":"4","individual_note":false,"notes":[{"source_id":"8","kind":"comment","resolvable":true,"resolved":false},{"source_id":"9","kind":"comment"}]}`)
+	snapshot := Object{Kind: "discussion_snapshot", SourceID: "thread-1", ParentKind: "issue", ParentID: "4", Title: "来源讨论历史", Created: 1600000000, History: history}
+	batch := []Object{{Kind: "issue", SourceID: "4", Number: 1, Title: "历史议题", State: "open", Author: "source", Created: 1600000000, Updated: 1600000000},
+		{Kind: "comment", SourceID: "8", ParentKind: "issue", ParentID: "4", Author: "source", Content: "待解决", Created: 1600000000, Updated: 1600000000},
+		{Kind: "comment", SourceID: "9", ParentKind: "issue", ParentID: "4", Author: "source", Content: "回复", Created: 1600000000, Updated: 1600000000}, snapshot}
+	receipts, err := Apply(ctx, actor, key, batch)
+	require.NoError(t, err)
+	repeated, err := Apply(ctx, actor, key, batch)
+	require.NoError(t, err)
+	require.Equal(t, receipts, repeated)
+	issue, err := issues.GetIssueByID(ctx, receipts[0].TargetID)
+	require.NoError(t, err)
+	badges, err := DiscussionBadges(ctx, issue)
+	require.NoError(t, err)
+	require.Equal(t, "待解决", badges[receipts[1].TargetID].State)
+	require.Equal(t, "来源未提供状态", badges[receipts[2].TargetID].State)
+	page, err := Read(ctx, actor, key, 0)
+	require.NoError(t, err)
+	for _, v := range page.Objects {
+		require.True(t, v.Matches)
+	}
+	_, err = db.GetEngine(ctx).ID(receipts[3].TargetID).Cols("data").Update(&governance.MigrationHistory{Data: strings.ReplaceAll(string(history), `"resolved":false`, `"resolved":true`)})
+	require.NoError(t, err)
+	page, err = Read(ctx, actor, key, 0)
+	require.NoError(t, err)
+	require.False(t, page.Objects[3].Matches)
+	_, err = Apply(ctx, actor, key, []Object{snapshot})
+	require.ErrorIs(t, err, ErrConflict)
+}
+
+func TestDiscussionSnapshotRejectsBrokenAssociations(t *testing.T) {
+	for _, raw := range []string{`{}`, `{"thread_id":"wrong","parent_kind":"issue","parent_source_id":"4","notes":[]}`, `{"thread_id":"t","parent_kind":"issue","parent_source_id":"4","notes":[{"source_id":"8","kind":"comment"},{"source_id":"8","kind":"comment"}]}`} {
+		require.ErrorIs(t, Validate(Object{Kind: "discussion_snapshot", SourceID: "t", ParentKind: "issue", ParentID: "4", Created: 1, History: json.RawMessage(raw)}), ErrInvalid)
+	}
+}
+
+func TestSourceDiscussionFieldsKeepMissingNullAndFalse(t *testing.T) {
+	fields := map[string]json.RawMessage{"null": json.RawMessage(`null`), "no": json.RawMessage(`false`),
+		"resolved_by": json.RawMessage(`{"id":123,"username":"source-user","name":"来源审阅人"}`),
+		"resolved_at": json.RawMessage(`"2026-10-29T01:02:03+08:00"`)}
+	require.Equal(t, "来源未提供", sourceValue(fields, "missing"))
+	require.Equal(t, "来源返回空值", sourceValue(fields, "null"))
+	require.Equal(t, "否", sourceValue(fields, "no"))
+	require.Equal(t, "姓名：来源审阅人 · 用户名：source-user · 来源编号：123", sourceValue(fields, "resolved_by"))
+	require.Equal(t, "2026-10-29T01:02:03+08:00", sourceValue(fields, "resolved_at"))
+}
+
+// 新增对抗用例：合法格式的快照依赖缺失，整笔事务必须回滚。
+func TestReviewDiscussionTransactionRollback(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	ctx := t.Context()
+	actor, err := users.GetUserByID(ctx, 1)
+	require.NoError(t, err)
+	key := strings.Repeat("a", 32)
+	repo := &repos.Repository{OwnerID: actor.ID, OwnerName: actor.Name, Name: "gm-migrate-" + key, LowerName: "gm-migrate-" + key, IsPrivate: true}
+	require.NoError(t, db.Insert(ctx, repo))
+	session, err := Start(ctx, actor, StartOptions{Key: key, RepoID: repo.ID, SourceDigest: strings.Repeat("b", 64), BatchKey: key, BatchSize: 1})
+	require.NoError(t, err)
+	objects := []Object{
+		{Kind: "issue", SourceID: "4", Number: 1, Title: "事务回滚议题", State: "open", Author: "来源作者", Created: 1600000000, Updated: 1600000000},
+		{Kind: "comment", SourceID: "8", ParentKind: "issue", ParentID: "4", Content: "来源评论", Author: "来源作者", Created: 1600000000, Updated: 1600000000},
+		{Kind: "discussion_snapshot", SourceID: "thread", ParentKind: "issue", ParentID: "4", Title: "来源线程", Created: 1600000000, History: json.RawMessage(`{"thread_id":"thread","parent_kind":"issue","parent_source_id":"4","notes":[{"source_id":"missing","kind":"comment"}]}`)},
+	}
+	_, err = Apply(ctx, actor, key, objects)
+	require.Error(t, err)
+	count, err := db.GetEngine(ctx).Where("session_id = ?", session.ID).Count(new(governance.MigrationReceipt))
+	require.NoError(t, err)
+	require.Zero(t, count, "依赖失败不能留下部分回执")
+	count, err = db.GetEngine(ctx).Where("repo_id = ?", repo.ID).Count(new(issues.Issue))
+	require.NoError(t, err)
