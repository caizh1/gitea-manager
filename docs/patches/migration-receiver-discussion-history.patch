+	}
+	_, err = db.GetEngine(ctx).ID(s.ID).Cols("seal_manifest_version", "seal_manifest_digest").Update(&governance.MigrationSession{SealManifestVersion: 1, SealManifestDigest: m.Digest})
+	return err
+}
+func TestManifestPortableEncoding(t *testing.T) {
+	require.Equal(t, "1a224ce7d11d06f22b21f11b8f61d4dc707072dee76e84ad7c4320436e4f1fda", metadataDigest(AssetOptions{SourceID: "附件-😀", Name: "a\nb.zip", ParentKind: "comment", ParentID: "9007199254740993", SHA256: "摘要", Size: 123, Created: 1600000000}))
+}
+
+func TestMigrationIssueIndexNeverRegresses(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	ctx := t.Context()
+	require.NoError(t, syncIssueIndex(ctx, 1))
+	require.NoError(t, syncIssueIndex(ctx, 1))
+	_, err := db.GetEngine(ctx).Exec("UPDATE issue_index SET max_index=1000 WHERE group_id=1")
+	require.NoError(t, err)
+	require.NoError(t, syncIssueIndex(ctx, 1))
+	var saved int64
+	_, err = db.GetEngine(ctx).SQL("SELECT max_index FROM issue_index WHERE group_id=1").Get(&saved)
+	require.NoError(t, err)
+	require.EqualValues(t, 1000, saved)
+}
