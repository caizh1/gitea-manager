--- /dev/null
+++ b/services/convert/migration_members_test.go
@@ -0,0 +1,30 @@
+// Copyright 2026 Gitea.
+// SPDX-License-Identifier: MIT
+
+package convert
+
+import (
+	"testing"
+
+	"gitea.dev/models/db"
+	git_model "gitea.dev/models/git"
+	governance "gitea.dev/models/governance"
+	repo_model "gitea.dev/models/repo"
+	"gitea.dev/models/unit"
+	"gitea.dev/models/unittest"
+	"github.com/stretchr/testify/require"
+)
+
+func TestMigrationWhitelistIncludesInheritedMembers(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	ctx := t.Context()
+	require.NoError(t, governance.InitializeLegacyNamespaces(ctx))
+	repo := &repo_model.Repository{OwnerID: 3, Name: "migration-whitelist", LowerName: "migration-whitelist", IsPrivate: true}
+	require.NoError(t, db.Insert(ctx, repo))
+	require.NoError(t, db.Insert(ctx, &repo_model.RepoUnit{RepoID: repo.ID, Type: unit.TypeCode}, &repo_model.RepoUnit{RepoID: repo.ID, Type: unit.TypePullRequests}))
+	// 仅通过治理群组获得权限，没有原生仓库协作者记录。
+	require.NoError(t, db.Insert(ctx, &governance.Membership{ScopeType: "group", ScopeID: 3, UserID: 4, Role: governance.Reporter}))
+	require.NoError(t, repo.LoadOwner(ctx))
+	result := ToBranchProtection(ctx, &git_model.ProtectedBranch{RepoID: repo.ID, RuleName: "main", ApprovalsWhitelistUserIDs: []int64{4}}, repo)
+	require.Equal(t, []string{"user4"}, result.ApprovalsWhitelistUsernames)
+}
