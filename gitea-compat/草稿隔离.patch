+func TestPendingReviewDoesNotCreatePublicTimeline(t *testing.T) {
+	assert.NoError(t, unittest.PrepareTestDatabase())
+	issue := unittest.AssertExistsAndLoadBean(t, &issues_model.Issue{ID: 3})
+	assert.NoError(t, issue.LoadRepo(t.Context()))
+	assert.NoError(t, issue.Repo.LoadOwner(t.Context()))
+	reviewer := unittest.AssertExistsAndLoadBean(t, &user_model.User{ID: 1})
+	review, comment, err := issues_model.SubmitReview(t.Context(), reviewer, issue, issues_model.ReviewTypePending, "未公开的草稿", "", false, nil)
+	assert.NoError(t, err)
+	assert.Nil(t, comment)
+	assert.Equal(t, issues_model.ReviewTypePending, review.Type)
+	unittest.AssertNotExistsBean(t, &issues_model.Comment{ReviewID: review.ID, Type: issues_model.CommentTypeReview})
+	final, comment, err := issues_model.SubmitReview(t.Context(), reviewer, issue, issues_model.ReviewTypeComment, "确认发布", "", false, nil)
+	assert.NoError(t, err)
+	assert.NotNil(t, comment)
+	assert.Equal(t, review.ID, final.ID)
+	assert.Equal(t, issues_model.ReviewTypeComment, final.Type)
+}
